@page
@model Nirvachak_AI.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Nirvachak AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body>
<div class="login-wrapper">
    <div class="login-card card p-4">
        <div class="text-center mb-4">
            <i class="bi bi-key-fill text-warning fs-1"></i>
            <h4 class="mt-2 mb-0 fw-bold">Forgot Password</h4>
            <small class="text-muted">Enter your email to receive a reset link</small>
        </div>

        @if (Model.EmailSent)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Reset link sent!</strong><br />
                If an account exists for <strong>@Model.Input.Email</strong>, you will receive
                a password reset email within a few minutes. Check your spam folder too.
            </div>
            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="btn btn-outline-primary w-100">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2">
                    <i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage
                </div>
            }
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Input.Email" class="form-control" placeholder="you@election.com" autofocus />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-send me-1"></i>Send Reset Link
                </button>
            </form>
            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="small text-muted">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
        }
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
