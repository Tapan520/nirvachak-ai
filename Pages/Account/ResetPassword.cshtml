@page
@model Nirvachak_AI.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Nirvachak AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body>
<div class="login-wrapper">
    <div class="login-card card p-4">
        <div class="text-center mb-4">
            <i class="bi bi-shield-lock-fill text-primary fs-1"></i>
            <h4 class="mt-2 mb-0 fw-bold">Reset Password</h4>
            <small class="text-muted">Enter your new password below</small>
        </div>

        @if (Model.ResetSuccess)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Password reset successfully!</strong><br />
                You can now sign in with your new password.
            </div>
            <a asp-page="/Account/Login" class="btn btn-primary w-100 mt-2">
                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
            </a>
        }
        else if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @Model.ErrorMessage
            </div>
            <a asp-page="/Account/ForgotPassword" class="btn btn-outline-primary w-100 mt-2">
                <i class="bi bi-arrow-left me-1"></i>Request New Reset Link
            </a>
        }
        else
        {
            <form method="post">
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Token" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label fw-semibold">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.NewPassword" class="form-control" placeholder="Min. 6 chars, 1 uppercase, 1 digit" />
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Repeat new password" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-check-circle me-1"></i>Set New Password
                </button>
            </form>
        }
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
