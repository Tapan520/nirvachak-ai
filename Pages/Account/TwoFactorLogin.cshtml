@page
@model Nirvachak_AI.Pages.Account.TwoFactorLoginModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>2FA - Nirvachak AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body>
<div class="login-wrapper">
    <div class="login-card card p-4">
        <div class="text-center mb-4">
            <i class="bi bi-shield-lock-fill text-primary fs-1"></i>
            <h4 class="mt-2 mb-0 fw-bold">Two-Factor Authentication</h4>
            <small class="text-muted">Enter the code from your authenticator app</small>
        </div>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage
            </div>
        }
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.TwoFactorCode" class="form-label fw-semibold">Authenticator Code</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                    <input asp-for="Input.TwoFactorCode" class="form-control text-center fs-5 fw-bold letter-spacing-3"
                           autocomplete="one-time-code" inputmode="numeric"
                           maxlength="7" placeholder="000000" autofocus />
                </div>
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Input.RememberMachine" class="form-check-input" />
                <label asp-for="Input.RememberMachine" class="form-check-label small">Remember this machine for 30 days</label>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="bi bi-shield-check me-1"></i>Verify
            </button>
        </form>
        <div class="text-center mt-3">
            <a asp-page="/Account/Login" class="small text-muted">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
