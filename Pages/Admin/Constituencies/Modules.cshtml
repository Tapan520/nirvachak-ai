@page "{id:int}"
@model Nirvachak_AI.Pages.Admin.Constituencies.ModulesModel
@{
    ViewData["Title"] = "Module Access";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-auto-dismiss"><i class="bi bi-check-circle me-2"></i>@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-auto-dismiss"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1"><i class="bi bi-toggles2 me-2"></i>Module Access Control</h4>
        <div class="text-muted small">Constituency: <strong>@Model.Constituency?.Name</strong> (@Model.Constituency?.Code)</div>
    </div>
    <a asp-page="/Admin/Constituencies/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Constituencies
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="post" asp-page-handler="Copy" class="row g-2 align-items-end">
            <div class="col-md-8 col-lg-6">
                <label asp-for="SourceConstituencyId" class="form-label fw-semibold mb-1">Copy settings from constituency</label>
                <select asp-for="SourceConstituencyId" class="form-select">
                    <option value="">Select constituency...</option>
                    @foreach (var c in Model.SourceConstituencies)
                    {
                        <option value="@c.Id">@c.Name (@c.Code)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"
                        onclick="return confirm('Copy module settings to this constituency? Existing settings will be overwritten.');">
                    <i class="bi bi-copy me-1"></i>Copy Settings
                </button>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-page-handler="Save" id="moduleForm">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Module Permissions</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-success" id="btnEnableAll">Enable All</button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="btnDisableAll">Disable All</button>
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-save me-1"></i>Save Changes
                </button>
            </div>
        </div>
        <div class="card-body">
            @foreach (var module in Model.Catalog)
            {
                <div class="mb-3">
                    <div class="text-uppercase fw-semibold text-muted small mb-2">@module.Name</div>
                    <div class="row g-2">
                        @foreach (var sub in module.SubModules)
                        {
                            <div class="col-md-6 col-lg-4">
                                <label class="border rounded px-3 py-2 d-flex align-items-center justify-content-between">
                                    <span>@sub.Name</span>
                                    <input type="checkbox"
                                           class="form-check-input module-toggle"
                                           name="ModuleState[@sub.Key]"
                                           value="true"
                                           @(Model.ModuleState.GetValueOrDefault(sub.Key, true) ? "checked" : null) />
                                    <input type="hidden" name="ModuleState[@sub.Key]" value="false" />
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        const toggles = () => Array.from(document.querySelectorAll('.module-toggle'));

        document.getElementById('btnEnableAll')?.addEventListener('click', () => {
            toggles().forEach(cb => cb.checked = true);
        });

        document.getElementById('btnDisableAll')?.addEventListener('click', () => {
            toggles().forEach(cb => cb.checked = false);
        });
    })();
</script>
}
