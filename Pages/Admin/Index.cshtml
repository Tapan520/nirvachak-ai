@page
@model Nirvachak_AI.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "User Management";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-auto-dismiss"><i class="bi bi-check-circle me-2"></i>@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-auto-dismiss"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">@Model.Users.Count user(s)</span>
    <a asp-page="/Admin/CreateUser" class="btn btn-primary btn-sm">
        <i class="bi bi-person-plus me-1"></i>Create User
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Name</th><th>Email</th><th>Role</th><th>Constituency</th><th>Ward</th><th>Booths</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td class="small">@u.Email</td>
                        <td>
                            <span class="badge @(u.Role == UserRole.SuperAdmin ? "bg-dark" :
                                u.Role == UserRole.Admin ? "bg-danger" :
                                u.Role == UserRole.CampaignManager ? "bg-primary" :
                                u.Role == UserRole.Candidate ? "bg-warning text-dark" :
                                u.Role == UserRole.BoothAgent ? "bg-info text-dark" : "bg-secondary")">
                                @u.Role
                            </span>
                        </td>
                        <td class="small">@(u.Constituency?.Name ?? "-")</td>
                        <td class="small">@(u.AssignedWard ?? "-")</td>
                        <td class="small">@(u.AssignedBoothNumbers ?? "All")</td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                @(u.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-page="/Admin/EditUser" asp-route-id="@u.Id"
                                   class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-@(u.IsActive ? "warning" : "success") py-0 px-2"
                                            title="@(u.IsActive ? "Disable" : "Enable")">
                                        <i class="bi bi-@(u.IsActive ? "pause" : "play")"></i>
                                    </button>
                                </form>
                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                {
                                    <a asp-page="/Admin/DeleteUser" asp-route-id="@u.Id"
                                       class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No users found.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-clock-history me-2"></i>Audit Logs <span class="badge bg-secondary ms-1">@Model.AuditLogTotal</span></span>
        <div class="d-flex flex-wrap gap-2 align-items-center">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <select name="AuditUserFilter" class="form-select form-select-sm" style="max-width:180px" onchange="this.form.submit()">
                <option value="">All Users</option>
                @foreach (var u in Model.AuditUsers)
                { <option value="@u" selected="@(Model.AuditUserFilter == u)">@u</option> }
            </select>
            <select name="AuditActionFilter" class="form-select form-select-sm" style="max-width:180px" onchange="this.form.submit()">
                <option value="">All Actions</option>
                @foreach (var a in Model.AuditActions)
                { <option value="@a" selected="@(Model.AuditActionFilter == a)">@a</option> }
            </select>
            <input type="date" name="AuditDateFrom" class="form-control form-control-sm" style="max-width:140px"
                   value="@Model.AuditDateFrom?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            <input type="date" name="AuditDateTo" class="form-control form-control-sm" style="max-width:140px"
                   value="@Model.AuditDateTo?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            @if (!string.IsNullOrEmpty(Model.AuditUserFilter) || !string.IsNullOrEmpty(Model.AuditActionFilter) || Model.AuditDateFrom.HasValue)
            {
                <a href="?" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
        @if (User.IsInRole("SuperAdmin"))
        {
            <form method="post" asp-page-handler="DeleteAllLogs"
                  onsubmit="return confirm('SuperAdmin only: Delete all matching audit log records? This cannot be undone.')">
                <input type="hidden" name="AuditUserFilter"   value="@Model.AuditUserFilter" />
                <input type="hidden" name="AuditActionFilter" value="@Model.AuditActionFilter" />
                <input type="hidden" name="AuditDateFrom"     value="@Model.AuditDateFrom?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="AuditDateTo"       value="@Model.AuditDateTo?.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-sm btn-danger">
                    <i class="bi bi-trash me-1"></i>Delete Filtered
                </button>
            </form>
        }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th>@if (User.IsInRole("SuperAdmin")) { <th></th> }</tr></thead>
                <tbody>
                @foreach (var log in Model.AuditLogs)
                {
                    <tr>
                        <td class="small text-muted">@log.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                        <td class="small fw-semibold">@log.UserName</td>
                        <td class="small"><span class="badge bg-secondary">@log.Action</span></td>
                        <td class="small">@log.EntityType @log.EntityId</td>
                        <td class="small text-muted">@(log.Details?.Length > 80 ? log.Details[..80] + "…" : log.Details)</td>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <td>
                                <form method="post" asp-page-handler="DeleteLog"
                                      onsubmit="return confirm('Delete this log entry?');">
                                    <input type="hidden" name="logId" value="@log.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.AuditLogs.Any())
                {
                    <tr><td colspan="@(User.IsInRole("SuperAdmin") ? 6 : 5)" class="text-center text-muted py-3 small">No audit logs match the filter.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
