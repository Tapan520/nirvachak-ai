@page
@model Nirvachak_AI.Pages.Admin.Rewards.IndexModel
@{
    ViewData["Title"] = "Reward & Coupon Config";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-gift-fill me-2 text-success"></i>Reward & Coupon Config</h4>
        <small class="text-muted">Configure reward pools and manage coupon inventory for voter survey incentives.</small>
    </div>
    <a asp-page="/Admin/Rewards/Create" class="btn btn-success btn-sm">
        <i class="bi bi-plus-circle me-1"></i>New Reward
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Reward Title</th>
                        <th>Partner Brand</th>
                        <th>Expiry Date</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Issued</th>
                        <th class="text-center">Redeemed</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Rewards)
                {
                    var isExpired = r.ExpiryDate < DateTime.Now;
                    <tr>
                        <td class="fw-semibold">@r.Title</td>
                        <td>@(r.PartnerBrand ?? "-")</td>
                        <td class="small @(isExpired ? "text-danger fw-semibold" : "")">
                            @r.ExpiryDate.ToString("dd MMM yyyy")
                            @if (isExpired) { <span class="badge bg-danger ms-1">Expired</span> }
                        </td>
                        <td class="text-center"><span class="badge bg-secondary">@r.TotalCoupons</span></td>
                        <td class="text-center">
                            <span class="badge bg-primary">@r.IssuedCount</span>
                            @if (r.TotalCoupons > 0)
                            {
                                <div class="progress mt-1" style="height:3px">
                                    <div class="progress-bar bg-primary" style="width:@(Math.Round((double)r.IssuedCount / r.TotalCoupons * 100))%"></div>
                                </div>
                            }
                        </td>
                        <td class="text-center"><span class="badge bg-success">@r.RedeemedCount</span></td>
                        <td>
                            @if (r.IsActive && !isExpired)
                            { <span class="badge bg-success">Active</span> }
                            else if (isExpired)
                            { <span class="badge bg-danger">Expired</span> }
                            else
                            { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Toggle" class="d-inline">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2">
                                    @(r.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                            <a asp-page="/Admin/Rewards/Details" asp-route-id="@r.Id"
                               class="btn btn-sm btn-outline-primary py-0 px-2 ms-1">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Rewards.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-gift fs-1 d-block mb-2 opacity-25"></i>
                            No reward configs yet.
                            <a asp-page="/Admin/Rewards/Create">Create your first reward</a> to get started.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
