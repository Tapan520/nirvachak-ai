@page "{id:int}"
@model Nirvachak_AI.Pages.Competitor.EditModel
@{
    ViewData["Title"] = "Edit Competitor Activity";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Competitor Activity</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input asp-for="Activity.Id" type="hidden" />
                    <input asp-for="Activity.ConstituencyId" type="hidden" />
                    <input asp-for="Activity.LoggedByUserId" type="hidden" />
                    <input asp-for="Activity.CreatedAt" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Competitor Name *</label>
                            <input asp-for="Activity.CompetitorName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Party Name</label>
                            <input asp-for="Activity.PartyName" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Activity Title *</label>
                            <input asp-for="Activity.ActivityTitle" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Activity Type</label>
                            <select asp-for="Activity.ActivityType" asp-items="Html.GetEnumSelectList<Nirvachak_AI.Domain.Enums.CompetitorActivityType>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Location</label>
                            <input asp-for="Activity.Location" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ward</label>
                            <input asp-for="Activity.Ward" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Booth No.</label>
                            <input asp-for="Activity.BoothNumber" class="form-control" type="number" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Activity Date *</label>
                            <input asp-for="Activity.ActivityDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estimated Crowd</label>
                            <input asp-for="Activity.EstimatedCrowd" class="form-control" type="number" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Threat Level</label>
                            <select asp-for="Activity.ThreatLevel" asp-items="Html.GetEnumSelectList<Nirvachak_AI.Domain.Enums.CompetitorThreatLevel>()" class="form-select"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes / Observations</label>
                            <textarea asp-for="Activity.Notes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Update</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
