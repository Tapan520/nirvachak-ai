@page
@model Nirvachak_AI.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var anyFilter = Model.SelectedConstituencyId.HasValue
                 || !string.IsNullOrEmpty(Model.SelectedWard)
                 || Model.SelectedBoothNumber.HasValue;
}

@* ── Page header ──────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-0">
            <i class="bi bi-speedometer2 me-2 text-primary"></i>
            @if (Model.IsFieldWorker)
            {
                <span>Field Dashboard</span>
            }
            else
            {
                <span>Dashboard</span>
            }
        </h4>
        @if (!string.IsNullOrEmpty(Model.ActiveConstituencyName))
        {
            <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill me-1 text-primary"></i>@Model.ActiveConstituencyName</p>
        }
        else
        {
            <p class="text-muted small mb-0">
                @if (Model.IsFieldWorker)
                { <span>Your assigned voters, today's visits &amp; upcoming events.</span> }
                else
                { <span>Campaign overview &mdash; voters, booths, grievances and more.</span> }
            </p>
        }
    </div>
    @* Filters — Admin / Manager / Candidate only *@
    @if (!Model.IsFieldWorker && (Model.IsAdmin || Model.Wards.Any()))
    {
        <form method="get" class="d-flex flex-nowrap gap-2 align-items-center">
            @if (Model.IsAdmin)
            {
                <select name="SelectedConstituencyId" id="selConstituency"
                        class="form-select form-select-sm" style="max-width:200px"
                        onchange="clearChildren(['selWard','selBooth']); this.form.submit();">
                    <option value="">All Constituencies</option>
                    @foreach (var c in Model.Constituencies)
                    {
                        <option value="@c.Id" selected="@(Model.SelectedConstituencyId == c.Id)">@c.Name</option>
                    }
                </select>
            }
            @if (Model.Wards.Any())
            {
                @if (!Model.IsAdmin && Model.SelectedConstituencyId.HasValue)
                {
                    <input type="hidden" name="SelectedConstituencyId" value="@Model.SelectedConstituencyId" />
                }
                <select name="SelectedWard" id="selWard"
                        class="form-select form-select-sm" style="max-width:160px"
                        onchange="clearChildren(['selBooth']); this.form.submit();">
                    <option value="">All Wards</option>
                    @foreach (var w in Model.Wards)
                    {
                        <option value="@w.WardNumber" selected="@(Model.SelectedWard == w.WardNumber)">@w.WardName</option>
                    }
                </select>
            }
            @if (Model.BoothOptions.Any())
            {
                <input type="hidden" name="SelectedWard" value="@Model.SelectedWard" />
                <select name="SelectedBoothNumber" id="selBooth"
                        class="form-select form-select-sm" style="max-width:160px"
                        onchange="this.form.submit();">
                    <option value="">All Booths</option>
                    @foreach (var b in Model.BoothOptions)
                    {
                        <option value="@b.BoothNumber" selected="@(Model.SelectedBoothNumber == b.BoothNumber)">
                            Booth #@b.BoothNumber &ndash; @b.BoothName
                        </option>
                    }
                </select>
            }
            @if (anyFilter)
            {
                <a href="/Dashboard" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
    }
</div>

@* ── Critical alerts + unacknowledged banner (all roles) ──────── *@
@if (Model.CriticalAlerts.Any())
{
    <div class="mb-3">
        @foreach (var vm in Model.CriticalAlerts)
        {
            <div class="alert alert-danger border-danger border-2 d-flex align-items-start gap-3 mb-2 shadow-sm py-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0 text-danger"></i>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-danger">CRITICAL ALERT</span>
                        <strong>@vm.Announcement.Title</strong>
                        <small class="text-muted ms-2">@vm.Announcement.CreatedByName &middot; @vm.Announcement.CreatedAt.ToLocalTime().ToString("dd MMM, h:mm tt")</small>
                        <a asp-page="/Announcements/Index" class="btn btn-sm btn-outline-danger py-0 ms-auto">View All</a>
                    </div>
                    <div class="small mt-1">@vm.Announcement.Body</div>
                </div>
            </div>
        }
    </div>
}
@if (Model.UnacknowledgedCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-3">
        <i class="bi bi-bell-fill text-warning"></i>
        <span>You have <strong>@Model.UnacknowledgedCount</strong> announcement@(Model.UnacknowledgedCount > 1 ? "s" : "") requiring acknowledgement.</span>
        <a asp-page="/Announcements/Index" class="btn btn-sm btn-warning ms-auto">Review</a>
    </div>
}

@* ═══════════════════════════════════════════════════════════════ *@
@*  FIELD WORKER / BOOTH AGENT  —  Focused operational view        *@
@* ═══════════════════════════════════════════════════════════════ *@
@if (Model.IsFieldWorker)
{
    @* Today's KPI bar *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100 border-primary">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10">
                        <i class="bi bi-people-fill text-primary"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.MyAssignedVoters</div>
                        <div class="small text-muted">My Voters</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100 border-success">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10">
                        <i class="bi bi-person-check-fill text-success"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-success">@Model.MyContactedToday</div>
                        <div class="small text-muted">Visited Today</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info bg-opacity-10">
                        <i class="bi bi-person-lines-fill text-info"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.MyTotalContacted</div>
                        <div class="small text-muted">Total Contacted</div>
                        <div class="progress mt-1" style="height:4px;width:70px">
                            @{ var fw_pct = Model.MyAssignedVoters > 0 ? Model.MyTotalContacted * 100 / Model.MyAssignedVoters : 0; }
                            <div class="progress-bar bg-info" style="width:@fw_pct%"></div>
                        </div>
                        <div style="font-size:0.65rem" class="text-muted">@fw_pct% coverage</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card h-100 border-warning">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10">
                        <i class="bi bi-person-exclamation text-warning"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-warning">@Model.MyPendingVoters</div>
                        <div class="small text-muted">Yet to Contact</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @* Next voters to visit *@
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-map-fill me-2 text-primary"></i>Next Voters to Visit <span class="badge bg-primary ms-1">Favour — Uncontacted</span></span>
                    <a asp-page="/Voters/Index" class="btn btn-sm btn-outline-primary">Full List</a>
                </div>
                @if (!Model.MyNextVoters.Any())
                {
                    <div class="card-body text-center text-success py-4">
                        <i class="bi bi-check2-all fs-2 d-block mb-2"></i>All Favour voters in your area have been contacted!
                    </div>
                }
                else
                {
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light"><tr><th>Name</th><th>Booth</th><th>Mobile</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var v in Model.MyNextVoters)
                                {
                                    var msg = Uri.EscapeDataString($"Dear {v.Name}, this is a courtesy call from our campaign team.");
                                    <tr>
                                        <td>
                                            <div class="fw-semibold small">@v.Name</div>
                                            <div class="text-muted" style="font-size:0.72rem">@v.Address</div>
                                        </td>
                                        <td><span class="badge bg-secondary">@v.BoothNumber</span></td>
                                        <td class="small">@(v.MobileNumber ?? "—")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                @if (!string.IsNullOrEmpty(v.MobileNumber))
                                                {
                                                    <a href="tel:@v.MobileNumber" class="btn btn-sm btn-outline-primary py-0 px-2" title="Call"><i class="bi bi-telephone-fill"></i></a>
                                                    <a href="https://wa.me/91@(v.MobileNumber)?text=@msg" target="_blank" class="btn btn-sm btn-success py-0 px-2" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                                                }
                                                <a asp-page="/Voters/Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Open"><i class="bi bi-eye"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Today's visit log *@
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clock-history me-2 text-info"></i>My Visits Today</span>
                    <span class="badge bg-info">@Model.MyTodayVisits.Count</span>
                </div>
                @if (!Model.MyTodayVisits.Any())
                {
                    <div class="card-body text-center text-muted py-4 small">No visits logged today yet.</div>
                }
                else
                {
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>Time</th><th>Voter ID</th><th>Status</th><th>Sentiment</th></tr></thead>
                                <tbody>
                                @foreach (var visit in Model.MyTodayVisits)
                                {
                                    <tr>
                                        <td class="small text-muted">@visit.VisitedAt.ToLocalTime().ToString("h:mm tt")</td>
                                        <td class="small font-monospace">@(visit.Voter?.VoterId ?? visit.VoterId.ToString())</td>
                                        <td><span class="badge bg-info text-dark small">@visit.Status</span></td>
                                        <td><span class="badge badge-@visit.SentimentAfterVisit.ToString().ToLower() small">@visit.SentimentAfterVisit</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                <div class="card-footer text-end">
                    <a asp-page="/Voters/Index" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle me-1"></i>Log a Visit</a>
                </div>
            </div>
        </div>
    </div>

    @* Upcoming events + announcements *@
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-calendar-event me-2 text-success"></i>Upcoming Events</div>
                <div class="card-body p-0">
                    @if (!Model.MyUpcomingEvents.Any())
                    {
                        <div class="p-3 text-center text-muted small">No upcoming events.</div>
                    }
                    @foreach (var ev in Model.MyUpcomingEvents)
                    {
                        <div class="d-flex align-items-start gap-2 px-3 py-2 border-bottom">
                            <div class="badge bg-success rounded-circle p-2"><i class="bi bi-calendar3"></i></div>
                            <div>
                                <div class="small fw-semibold">@ev.Title</div>
                                <div class="text-muted" style="font-size:0.75rem">@ev.ScheduledAt.ToString("dd MMM, h:mm tt") &mdash; @ev.Location</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer text-end">
                    <a asp-page="/Campaign/Index" class="btn btn-sm btn-outline-success">View All</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-megaphone-fill me-2 text-primary"></i>Recent Announcements</span>
                    <a asp-page="/Announcements/Index" class="btn btn-sm btn-outline-primary">All</a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentAnnouncements.Any())
                    {
                        <div class="text-center text-muted py-3 small">No announcements.</div>
                    }
                    @foreach (var vm in Model.RecentAnnouncements)
                    {
                        var a = vm.Announcement;
                        <div class="d-flex align-items-start gap-2 px-3 py-2 border-bottom">
                            <i class="bi @a.CategoryIcon text-@a.CategoryColor mt-1"></i>
                            <div>
                                <div class="small fw-semibold">@a.Title
                                    @if (a.RequiresAcknowledgement && !vm.IsAcknowledged)
                                    {
                                        <span class="badge bg-warning text-dark ms-1"><i class="bi bi-bell-fill"></i></span>
                                    }
                                </div>
                                <div class="text-muted" style="font-size:0.72rem">@a.CreatedAt.ToLocalTime().ToString("dd MMM, h:mm tt")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
@* ═══════════════════════════════════════════════════════════════ *@
@*  ADMIN / MANAGER / CANDIDATE  —  Full campaign dashboard        *@
@* ═══════════════════════════════════════════════════════════════ *@

    @* Stat cards *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10"><i class="bi bi-people-fill text-primary"></i></div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.TotalVoters.ToString("N0")</div>
                        <div class="small text-muted">Total Voters</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10"><i class="bi bi-hand-thumbs-up-fill text-success"></i></div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.FavourVoters.ToString("N0")</div>
                        <div class="small text-muted">In Favour</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info bg-opacity-10"><i class="bi bi-person-check-fill text-info"></i></div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.ContactedVoters.ToString("N0")</div>
                        <div class="small text-muted">Contacted</div>
                        <div class="progress mt-1" style="height:4px;width:70px">
                            <div class="progress-bar bg-info" style="width:@Model.ContactCoveragePercent%"></div>
                        </div>
                        <div style="font-size:0.65rem" class="text-muted">@Model.ContactCoveragePercent% coverage</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10"><i class="bi bi-geo-alt-fill text-warning"></i></div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.TotalBooths</div>
                        <div class="small text-muted">Booths</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-danger bg-opacity-10"><i class="bi bi-exclamation-triangle-fill text-danger"></i></div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.OpenGrievances</div>
                        <div class="small text-muted">Open Grievances</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <a asp-page="/Analytics/SurveyDemographics" asp-route-FilterTab="pending" class="card stat-card h-100 text-decoration-none">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-secondary bg-opacity-10"><i class="bi bi-clipboard2-check-fill text-secondary"></i></div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.SurveyCompletedCount</div>
                        <div class="small text-muted">Surveyed</div>
                        <div style="font-size:0.65rem" class="text-danger">@Model.SurveyPendingCount pending</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @* Charts row *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Voter Sentiment</div>
                <div class="card-body">
                    <div class="chart-container" style="height:220px"><canvas id="sentimentChart"></canvas></div>
                    <div class="mt-3">
                        @foreach (var s in Model.SentimentBreakdown)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small">@s.Key</span>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="turnout-bar" style="width:80px">
                                        <div class="turnout-bar-fill" style="width:@(Model.TotalVoters > 0 ? (s.Value * 100 / Model.TotalVoters) : 0)%"></div>
                                    </div>
                                    <span class="small fw-bold">@s.Value</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-pie-chart-fill me-2 text-warning"></i>Religion Breakdown</span>
                    @if (Model.ProfiledVoterCount > 0)
                    { <span class="badge bg-secondary">@Model.ProfiledVoterCount surveyed</span> }
                </div>
                <div class="card-body">
                    @if (Model.ReligionBreakdown.Any())
                    {
                        <div class="chart-container" style="height:220px"><canvas id="religionChart"></canvas></div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted py-4 gap-2">
                            <i class="bi bi-pie-chart fs-1 opacity-25"></i>
                            <span class="small text-center">No religion data yet.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-pie-chart-fill me-2 text-success"></i>Caste Breakdown</span>
                    @if (Model.ProfiledVoterCount > 0)
                    { <span class="badge bg-secondary">@Model.ProfiledVoterCount surveyed</span> }
                </div>
                <div class="card-body">
                    @if (Model.CasteBreakdown.Any())
                    {
                        <div class="chart-container" style="height:220px"><canvas id="casteChart"></canvas></div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted py-4 gap-2">
                            <i class="bi bi-pie-chart fs-1 opacity-25"></i>
                            <span class="small text-center">No caste data yet.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Booth + Events *@
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-geo-alt me-2 text-warning"></i>Booth-wise Voters</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead><tr><th>Booth</th><th>Voters</th><th>Agent</th></tr></thead>
                            <tbody>
                            @foreach (var b in Model.BoothSummary)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">#@b.BoothNumber</span> @b.BoothName</td>
                                    <td>@b.TotalVoters</td>
                                    <td><span class="badge @(string.IsNullOrEmpty(b.AssignedAgentName) ? "bg-light text-muted" : "bg-success")">
                                        @(string.IsNullOrEmpty(b.AssignedAgentName) ? "Unassigned" : "Assigned")</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-clock-history me-2 text-info"></i>Upcoming Events</div>
                <div class="card-body p-0">
                    @if (!Model.UpcomingEvents.Any())
                    { <div class="p-3 text-center text-muted small">No upcoming events</div> }
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <div class="d-flex align-items-start gap-2 px-3 py-2 border-bottom">
                            <div class="badge bg-primary rounded-circle p-2"><i class="bi bi-calendar3"></i></div>
                            <div>
                                <div class="small fw-semibold">@ev.Title</div>
                                <div class="text-muted" style="font-size:0.75rem">@ev.ScheduledAt.ToString("dd MMM, h:mm tt") &mdash; @ev.Location</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer text-end">
                    <a asp-page="/Campaign/Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
            </div>
        </div>
    </div>

    @* Volunteers + EC Budget + Survey *@
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-check me-2 text-success"></i>Volunteers (@Model.TotalVolunteers)</span>
                    <a asp-page="/Volunteers/Index" class="btn btn-sm btn-outline-success">Manage</a>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col"><div class="fs-4 fw-bold text-success">@Model.ActiveVolunteers</div><div class="small text-muted">Active</div></div>
                        <div class="col"><div class="fs-4 fw-bold text-primary">@Model.TotalVolunteers</div><div class="small text-muted">Total</div></div>
