                    <a asp-page="/Expenses/Index" class="btn btn-sm btn-outline-warning">View</a>
                </div>
                <div class="card-body">
                    <div class="row text-center mb-3">
                        <div class="col"><div class="fs-4 fw-bold">&#8377;@Model.TotalExpenses.ToString("N0")</div><div class="small text-muted">Total Spent</div></div>
                        <div class="col"><div class="fs-4 fw-bold text-muted">&#8377;@Model.ECBudgetLimit.ToString("N0")</div><div class="small text-muted">EC Limit</div></div>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Budget Used</span>
                        <span class="fw-semibold @(Model.ECBudgetPercent >= 90 ? "text-danger" : Model.ECBudgetPercent >= 75 ? "text-warning" : "text-success")">@Model.ECBudgetPercent%</span>
                    </div>
                    <div class="progress" style="height:12px">
                        <div class="progress-bar @(Model.ECBudgetPercent >= 90 ? "bg-danger" : Model.ECBudgetPercent >= 75 ? "bg-warning" : "bg-success")"
                             style="width:@Model.ECBudgetPercent%"></div>
                    </div>
                    @if (Model.ECBudgetPercent >= 90)
                    {
                        <div class="alert alert-danger py-1 small mt-2 mb-0"><i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Warning:</strong> Approaching EC spending limit!</div>
                    }
                    else if (Model.ECBudgetPercent >= 75)
                    {
                        <div class="alert alert-warning py-1 small mt-2 mb-0"><i class="bi bi-exclamation-circle me-1"></i>75% of EC budget used.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clipboard2-check-fill me-2 text-secondary"></i>Voter Survey Progress</span>
                    <a asp-page="/Analytics/SurveyDemographics" class="btn btn-sm btn-outline-secondary">View</a>
                </div>
                <div class="card-body">
                    <div class="row text-center mb-3">
                        <div class="col"><div class="fs-4 fw-bold text-success">@Model.SurveyCompletedCount</div><div class="small text-muted">Completed</div></div>
                        <div class="col"><div class="fs-4 fw-bold text-danger">@Model.SurveyPendingCount</div><div class="small text-muted">Pending</div></div>
                    </div>
                    @{ var surveyPct2 = Model.TotalVoters > 0 ? (int)Math.Round((double)Model.SurveyCompletedCount / Model.TotalVoters * 100) : 0; }
                    <div class="d-flex justify-content-between small mb-1"><span>Completion Rate</span><span class="fw-semibold">@surveyPct2%</span></div>
                    <div class="progress" style="height:8px"><div class="progress-bar bg-secondary" style="width:@surveyPct2%"></div></div>
                    <div class="mt-3 text-center">
                        <a asp-page="/Analytics/SurveyDemographics" asp-route-FilterTab="pending" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="bi bi-send me-1"></i>Send Survey Links
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Announcements *@
    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-megaphone-fill me-2 text-primary"></i>Recent Announcements</span>
                    <a asp-page="/Announcements/Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentAnnouncements.Any())
                    { <div class="text-center text-muted py-3 small">No announcements yet.</div> }
                    @foreach (var vm in Model.RecentAnnouncements)
                    {
                        var a = vm.Announcement;
                        <div class="d-flex align-items-start gap-3 px-3 py-2 border-bottom">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 mt-1"
                                 style="width:34px;height:34px;background:var(--bs-body-bg);border:1px solid var(--bs-border-color);">
                                <i class="bi @a.CategoryIcon text-@a.CategoryColor"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge bg-@a.CategoryColor">@a.CategoryLabel</span>
                                    <span class="fw-semibold small">@a.Title</span>
                                    @if (a.RequiresAcknowledgement && !vm.IsAcknowledged)
                                    { <span class="badge bg-warning text-dark"><i class="bi bi-bell-fill me-1"></i>Action needed</span> }
                                </div>
                                <div class="text-muted" style="font-size:0.75rem">@a.CreatedByName &middot; @a.CreatedAt.ToLocalTime().ToString("dd MMM, h:mm tt")</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer text-end">
                    <a asp-page="/Announcements/Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Post Announcement</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    function clearChildren(ids) {
        ids.forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    }
    const chartOpts = {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, boxWidth: 12 } } }
    };
</script>

@if (!Model.IsFieldWorker && Model.SentimentBreakdown.Any())
{
    <script>
    new Chart(document.getElementById('sentimentChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SentimentBreakdown.Keys)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SentimentBreakdown.Values)),
                backgroundColor: ['#51cf66','#ff6b6b','#74c0fc','#ffd43b','#adb5bd'], borderWidth: 0 }]
        },
        options: chartOpts
    });
    </script>
}

@if (!Model.IsFieldWorker && Model.ReligionBreakdown.Any())
{
    <script>
    new Chart(document.getElementById('religionChart').getContext('2d'), {
        type: 'pie',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReligionBreakdown.Keys)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReligionBreakdown.Values)),
                backgroundColor: ['#f76707','#2f9e44','#1971c2','#ae3ec9','#e67700','#2b8a3e','#c92a2a'], borderWidth: 0 }]
        },
        options: chartOpts
    });
    </script>
}

@if (!Model.IsFieldWorker && Model.CasteBreakdown.Any())
{
    <script>
    new Chart(document.getElementById('casteChart').getContext('2d'), {
        type: 'pie',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CasteBreakdown.Keys)),
            datasets: [{ data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CasteBreakdown.Values)),
                backgroundColor: ['#3b5bdb','#0c8599','#e67700','#2f9e44','#c92a2a'], borderWidth: 0 }]
        },
        options: chartOpts
    });
    </script>
}
}
        @if (!string.IsNullOrEmpty(Model.ActiveConstituencyName))
        {
            <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill me-1 text-primary"></i>@Model.ActiveConstituencyName</p>
        }
        else
        {
            <p class="text-muted small mb-0">Campaign overview &mdash; voters, booths, grievances and more.</p>
        }
    </div>
    @if (Model.IsAdmin || Model.Wards.Any())
    {
        <form method="get" class="d-flex flex-nowrap gap-2 align-items-center">
            @if (Model.IsAdmin)
            {
                <select name="SelectedConstituencyId" id="selConstituency"
                        class="form-select form-select-sm" style="max-width:200px"
                        onchange="clearChildren(['selWard','selBooth']); this.form.submit();">
                    <option value="">All Constituencies</option>
                    @foreach (var c in Model.Constituencies)
                    {
                        <option value="@c.Id" selected="@(Model.SelectedConstituencyId == c.Id)">@c.Name</option>
                    }
                </select>
            }
            @if (Model.Wards.Any())
            {
                @if (!Model.IsAdmin && Model.SelectedConstituencyId.HasValue)
                {
                    <input type="hidden" name="SelectedConstituencyId" value="@Model.SelectedConstituencyId" />
                }
                <select name="SelectedWard" id="selWard"
                        class="form-select form-select-sm" style="max-width:160px"
                        onchange="clearChildren(['selBooth']); this.form.submit();">
                    <option value="">All Wards</option>
                    @foreach (var w in Model.Wards)
                    {
                        <option value="@w.WardNumber" selected="@(Model.SelectedWard == w.WardNumber)">@w.WardName</option>
                    }
                </select>
            }
            @if (Model.BoothOptions.Any())
            {
                <input type="hidden" name="SelectedWard" value="@Model.SelectedWard" />
                <select name="SelectedBoothNumber" id="selBooth"
                        class="form-select form-select-sm" style="max-width:160px"
                        onchange="this.form.submit();">
                    <option value="">All Booths</option>
                    @foreach (var b in Model.BoothOptions)
                    {
                        <option value="@b.BoothNumber" selected="@(Model.SelectedBoothNumber == b.BoothNumber)">
                            Booth #@b.BoothNumber &ndash; @b.BoothName
                        </option>
                    }
                </select>
            }
            @if (anyFilter)
            {
                <a href="/Dashboard" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
    }
</div>

<!-- Stats Row -->
