@page
@model Nirvachak_AI.Pages.ElectionDay.IndexModel
@{
    ViewData["Title"] = "Election Day - Live Tracking";
}

<div class="row g-3 mb-4">
@if (TempData["Message"] != null)
{
    <div class="col-12"><div class="alert alert-success alert-auto-dismiss">@TempData["Message"]</div></div>
}
@if (TempData["Error"] != null)
{
    <div class="col-12"><div class="alert alert-warning alert-auto-dismiss">@TempData["Error"]</div></div>
}
@if (Model.IsAdmin)
{
    <div class="col-12">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <form method="get" class="d-flex align-items-center gap-2">
                <label class="fw-semibold mb-0 text-nowrap">Constituency:</label>
                <select name="constituencyFilter" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:280px">
                    @foreach (var c in Model.Constituencies)
                    {
                        <option value="@c.Id" selected="@(Model.ConstituencyId == c.Id)">@c.Name</option>
                    }
                </select>
            </form>
            <a asp-page="/Reports/ElectionDay" asp-route-ConstituencyFilter="@Model.ConstituencyId"
               target="_blank" class="btn btn-sm btn-outline-secondary ms-auto">
                <i class="bi bi-printer me-1"></i>Print Report
            </a>
        </div>
    </div>
}
else
{
    <div class="col-12 d-flex justify-content-end">
        <a asp-page="/Reports/ElectionDay" target="_blank" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer me-1"></i>Print Report
        </a>
    </div>
}
<div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                    <span class="live-dot"></span>
                    <span class="text-success fw-semibold small">LIVE</span>
                </div>
                <div id="overall-turnout" class="display-5 fw-bold text-primary">@Model.OverallPercent%</div>
                <div class="text-muted small">Overall Turnout</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div id="overall-voted" class="display-5 fw-bold text-success">@Model.TotalVoted</div>
                <div class="text-muted small">Voters Voted</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="display-5 fw-bold text-secondary">@Model.TotalVoters</div>
                <div class="text-muted small">Total Eligible Voters</div>
            </div>
        </div>
    </div>
</div>

<!-- Mark Voter Voted -->
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-check2-square me-2 text-success"></i>Mark Voter as Voted</div>
    <div class="card-body">
        <form method="post" asp-page-handler="MarkVoted" class="row g-2 align-items-end" id="markVotedForm">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Search Voter (EPIC / Name)</label>
                <input type="text" id="voterSearch" class="form-control" placeholder="Type EPIC or name..." autocomplete="off" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Select Voter</label>
                <select name="voterId" id="voterSelect" class="form-select">
                    <option value="">-- search above --</option>
                    @foreach (var v in Model.TodayVoters)
                    {
                        <option value="@v.Id" data-name="@v.Name" data-epic="@v.VoterId">
                            [@v.VoterId] @v.Name - Booth @v.BoothNumber (@v.ElectionDayStatus)
                        </option>
                    }
                </select>
                <div id="voterSelectError" class="text-danger small d-none">Please select a voter.</div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-check-circle me-1"></i>Mark Voted
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Booth-wise Turnout -->
<div class="card mb-4">
    <div class="card-header"><i class="bi bi-bar-chart me-2"></i>Booth-wise Live Turnout</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr><th>Booth</th><th>Booth Name</th><th>Total</th><th>Voted</th><th>Turnout</th><th>Progress</th></tr>
                </thead>
                <tbody>
                @foreach (var b in Model.BoothTurnout)
                {
                    <tr data-booth="@b.BoothNumber">
                        <td><span class="badge bg-primary">#@b.BoothNumber</span></td>
                        <td>@b.BoothName</td>
                        <td>@b.TotalVoters</td>
                        <td class="voted-count fw-bold text-success">@b.VotedCount</td>
                        <td class="turnout-pct fw-bold">@b.TurnoutPercent%</td>
                        <td style="min-width:120px">
                            <div class="turnout-bar">
                                <div class="turnout-bar-fill" style="width:@b.TurnoutPercent%"></div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Priority Chase List: Favour voters not yet voted -->
<div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span>
            <i class="bi bi-person-exclamation me-2 text-danger"></i>
            <strong>Chase List</strong> — Favour Voters Not Yet Voted
        </span>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-danger">@Model.NotYetVotedFavour.Count pending</span>
            @if (Model.SmsBlastCount > 0)
            {
                <button type="button" class="btn btn-sm btn-success"
                        data-bs-toggle="modal" data-bs-target="#waBlastModal">
                    <i class="bi bi-whatsapp me-1"></i>WhatsApp All (@Model.SmsBlastCount)
                </button>
            }
            @if (Model.ExotelConfigured && Model.SmsBlastCount > 0)
            {
                <button type="button" class="btn btn-sm btn-warning"
                        data-bs-toggle="modal" data-bs-target="#smsBlastModal">
                    <i class="bi bi-send-fill me-1"></i>SMS Blast (@Model.SmsBlastCount)
                </button>
            }
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.NotYetVotedFavour.Any())
        {
            <div class="text-center text-success py-4">
                <i class="bi bi-check2-all fs-2 d-block mb-2"></i>All tracked Favour voters have voted!
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Name</th><th>EPIC</th><th>Booth</th><th>Mobile</th><th>Contact</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var v in Model.NotYetVotedFavour)
                    {
                        var msg = Uri.EscapeDataString($"Dear {v.Name}, please cast your vote today. Your vote matters!");
                        <tr>
                            <td class="fw-semibold small">@v.Name</td>
                            <td class="font-monospace small">@v.VoterId</td>
                            <td><span class="badge bg-secondary">@v.BoothNumber</span></td>
                            <td class="small">@(v.MobileNumber ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(v.MobileNumber))
                                {
                                    <a href="https://wa.me/91@(v.MobileNumber)?text=@msg" target="_blank"
                                       class="btn btn-sm btn-success py-0 px-2" title="WhatsApp reminder">
                                        <i class="bi bi-whatsapp"></i>
                                    </a>
                                    <a href="tel:@v.MobileNumber" class="btn btn-sm btn-outline-primary py-0 px-2 ms-1" title="Call">
                                        <i class="bi bi-telephone-fill"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ── WhatsApp Bulk Blast Modal (zero-cost, no API needed) ──────────────── *@
@if (Model.SmsBlastCount > 0)
{
    var waVoters = Model.NotYetVotedFavour.Where(v => !string.IsNullOrEmpty(v.MobileNumber)).ToList();
<div class="modal fade" id="waBlastModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background:#25d366">
                <h5 class="modal-title"><i class="bi bi-whatsapp me-2"></i>WhatsApp Blast &mdash; @waVoters.Count Unvoted Favour Voters</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Opens <strong>WhatsApp</strong> with a pre-filled message per voter &mdash; <strong>zero API cost</strong>.
                    Use <em>Open All</em> to send in sequence, or <em>Copy Numbers</em> for a group message.
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Message <span class="text-muted">(use [Name] as placeholder)</span></label>
                    <textarea id="waMessage" class="form-control form-control-sm" rows="3">Dear [Name], today is election day! Please cast your vote at your nearest polling booth before 6:00 PM. Your vote is your voice — every vote counts!</textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-muted">@waVoters.Count voters with mobile numbers</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="copyAllWANumbers()"><i class="bi bi-clipboard me-1"></i>Copy Numbers</button>
                </div>
                <div id="waCopyDone" class="small text-success mb-1 d-none"><i class="bi bi-check-circle me-1"></i>Copied!</div>
                <div style="max-height:280px;overflow-y:auto;border:1px solid #dee2e6;border-radius:6px">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width:30px"><input type="checkbox" id="waSelectAll" checked class="form-check-input" /></th>
                                <th>Name</th><th>Booth</th><th>Mobile</th><th class="text-center">Send</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var v in waVoters)
                        {
                            <tr>
                                <td><input type="checkbox" class="form-check-input wa-chk" checked data-num="@v.MobileNumber" data-name="@v.Name" /></td>
                                <td class="small fw-semibold">@v.Name</td>
                                <td><span class="badge bg-secondary">@v.BoothNumber</span></td>
                                <td class="small font-monospace">@v.MobileNumber</td>
                                <td class="text-center">
                                    <button onclick="waOpenOne('@v.MobileNumber','@v.Name')" class="btn btn-sm btn-success py-0 px-2"><i class="bi bi-whatsapp"></i></button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" onclick="waOpenAll()"><i class="bi bi-whatsapp me-1"></i>Open All in WhatsApp</button>
            </div>
        </div>
    </div>
</div>
}

@* SMS Blast Modal *@
@if (Model.ExotelConfigured && Model.SmsBlastCount > 0)
{
<div class="modal fade" id="smsBlastModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-send-fill me-2 text-warning"></i>SMS Blast to Favour Voters</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SmsBlast">
                <div class="modal-body">
                    <div class="alert alert-warning py-2 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        This will send an SMS to <strong>@Model.SmsBlastCount</strong> Favour voters who have not voted yet.
                        Standard Exotel SMS charges apply.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message <span class="text-muted fw-normal">(leave blank for default)</span></label>
                        <textarea name="customMessage" class="form-control" rows="3"
                                  placeholder="Default: 'Dear voter, polling is underway... Please exercise your right to vote today!'"></textarea>
                        <div class="form-text">Max 160 characters recommended for standard SMS.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"
                            onclick="return confirm('Send SMS to @Model.SmsBlastCount voters?')">
                        <i class="bi bi-send-fill me-1"></i>Send SMS Blast
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>window._constituencyId = @Model.ConstituencyId;</script>
<script src="~/js/electionday.js" asp-append-version="true"></script>
<script>
    // Simple voter search filter
    document.getElementById('voterSearch').addEventListener('input', function() {
        const search = this.value.toLowerCase();
        const select = document.getElementById('voterSelect');
        for (let opt of select.options) {
            if (opt.value === '') continue;
            opt.hidden = !opt.text.toLowerCase().includes(search);
        }
    });
    // Validate voter selection before submit
    document.getElementById('markVotedForm').addEventListener('submit', function(e) {
        const select = document.getElementById('voterSelect');
        const errEl = document.getElementById('voterSelectError');
        if (!select.value) {
            e.preventDefault();
            errEl.classList.remove('d-none');
        } else {
            errEl.classList.add('d-none');
        }
    });

    // ── WhatsApp Blast helpers ─────────────────────────────
    function waBuildMsg(name) {
        const tpl = document.getElementById('waMessage') ? document.getElementById('waMessage').value : 'Dear [Name], please vote today!';
        return encodeURIComponent(tpl.replace('[Name]', name));
    }
    function waOpenOne(mobile, name) {
        window.open('https://wa.me/91' + mobile + '?text=' + waBuildMsg(name), '_blank');
    }
    let _waIdx = 0, _waQ = [];
    function waOpenAll() {
        _waQ = [];
        document.querySelectorAll('.wa-chk:checked').forEach(function(cb) { _waQ.push({n: cb.dataset.num, name: cb.dataset.name}); });
        if (!_waQ.length) { alert('No voters selected.'); return; }
        if (!confirm('Open ' + _waQ.length + ' WhatsApp windows? Allow pop-ups if prompted.')) return;
        _waIdx = 0; waSendNext();
    }
    function waSendNext() {
        if (_waIdx >= _waQ.length) return;
        var v = _waQ[_waIdx++];
        window.open('https://wa.me/91' + v.n + '?text=' + waBuildMsg(v.name), '_blank');
        if (_waIdx < _waQ.length) setTimeout(waSendNext, 1200);
    }
    function copyAllWANumbers() {
        var nums = []; document.querySelectorAll('.wa-chk:checked').forEach(function(cb) { nums.push(cb.dataset.num); });
        if (!nums.length) { alert('No voters selected.'); return; }
        navigator.clipboard.writeText(nums.join('\n')).then(function() {
            var el = document.getElementById('waCopyDone'); if (el) { el.classList.remove('d-none'); setTimeout(function() { el.classList.add('d-none'); }, 3000); }
        });
    }
    var waAll = document.getElementById('waSelectAll');
    if (waAll) waAll.addEventListener('change', function() { document.querySelectorAll('.wa-chk').forEach(function(cb) { cb.checked = waAll.checked; }); });
</script>
}
