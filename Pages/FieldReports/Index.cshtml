@page
@model Nirvachak_AI.Pages.FieldReports.IndexModel
@using Nirvachak_AI.Domain.Enums
@{ ViewData["Title"] = "Field Activity Reports"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0"><i class="bi bi-clipboard2-check-fill me-2 text-primary"></i>Field Activity Reports</h4>
        <small class="text-muted">Daily field worker activity summaries</small>
    </div>
    <a asp-page="/FieldReports/Submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Submit Report</a>
</div>

@if (TempData["Message"] != null)
{ <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-1"></i>@TempData["Message"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<!-- Filters -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            @if (Model.IsAdmin && Model.Constituencies.Any())
            {
                <div class="col-auto">
                    <select name="ConstituencyFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All Constituencies</option>
                        @foreach (var c in Model.Constituencies) { <option value="@c.Id" selected="@(Model.ConstituencyFilter==c.Id)">@c.Name</option> }
                    </select>
                </div>
            }
            @if (Model.IsManager)
            {
                <div class="col-auto"><input type="text" name="WorkerFilter" class="form-control form-control-sm" placeholder="Filter by worker-" value="@Model.WorkerFilter" /></div>
            }
            <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button></div>
            <div class="col-auto"><a asp-page="/FieldReports/Index" class="btn btn-sm btn-outline-secondary">Clear</a></div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Worker</th><th>Contacts</th><th>Favour</th><th>Floating</th><th>Issues</th><th>Status</th><th>Highlights</th><th>Actions</th></tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Reports)
                {
                    var badge = r.Status switch { FieldReportStatus.Reviewed => "success", FieldReportStatus.Flagged => "danger", _ => "warning" };
                    <tr>
                        <td><strong>@r.ReportDate.ToString("dd MMM")</strong></td>
                        <td>@r.WorkerName</td>
                        <td><span class="badge bg-info">@r.ContactsMade</span></td>
                        <td><span class="badge bg-success">@r.FavourContacts</span></td>
                        <td><span class="badge bg-warning text-dark">@r.FloatingContacts</span></td>
                        <td><span class="badge bg-secondary">@r.IssuesLogged</span></td>
                        <td><span class="badge bg-@badge">@r.Status</span></td>
                        <td><small class="text-truncate d-block" style="max-width:180px">@r.Highlights</small></td>
                        <td>
                            <a asp-page="/FieldReports/View" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                            @if (Model.IsManager && r.Status == FieldReportStatus.Submitted)
                            {
                                <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#reviewModal@r.Id">Review</button>
                                <div class="modal fade" id="reviewModal@r.Id" tabindex="-1">
                                    <div class="modal-dialog"><div class="modal-content">
                                        <div class="modal-header"><h5 class="modal-title">Review Report</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                        <form method="post" asp-page-handler="Review">
                                            <div class="modal-body">
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <div class="mb-2">
                                                    <label class="form-label fw-semibold">Decision</label>
                                                    <select name="status" class="form-select">
                                                        <option value="Reviewed">Reviewed ?</option>
                                                        <option value="Flagged">Flagged ?</option>
                                                    </select>
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label fw-semibold">Manager Notes</label>
                                                    <textarea name="reviewerNotes" class="form-control" rows="2"></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Submit Review</button></div>
                                        </form>
                                    </div></div>
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Reports.Any())
                { <tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-clipboard2-x fs-3 d-block mb-2"></i>No reports found. <a asp-page="/FieldReports/Submit">Submit one</a></td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
