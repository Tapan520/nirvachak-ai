@page
@model Nirvachak_AI.Pages.Influencers.CreateModel
@{
    ViewData["Title"] = "Add Influencer";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header" style="background:#6f42c1; color:white">
                <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Add Influencer / Community Leader</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name *</label>
                            <input asp-for="Influencer.Name" class="form-control" />
                            <span asp-validation-for="Influencer.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mobile Number</label>
                            <input asp-for="Influencer.MobileNumber" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <input asp-for="Influencer.Category" class="form-control" placeholder="e.g. Religious, Caste, Youth" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Community</label>
                            <input asp-for="Influencer.Community" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Est. Followers / Voters Influenced</label>
                            <input asp-for="Influencer.EstimatedFollowers" class="form-control" type="number" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ward</label>
                            <input asp-for="Influencer.Ward" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Booth No.</label>
                            <input asp-for="Influencer.BoothNumber" class="form-control" type="number" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Alignment</label>
                            <select asp-for="Influencer.Alignment" asp-items="Html.GetEnumSelectList<Nirvachak_AI.Domain.Enums.InfluencerAlignment>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Met On</label>
                            <input asp-for="Influencer.LastMetAt" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Meeting Outcome</label>
                            <input asp-for="Influencer.LastMeetingOutcome" class="form-control" placeholder="e.g. Agreed to campaign" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea asp-for="Influencer.Notes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Influencer</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
