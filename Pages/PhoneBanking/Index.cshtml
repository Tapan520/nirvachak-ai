@page
@model Nirvachak_AI.Pages.PhoneBanking.IndexModel
@{
    ViewData["Title"] = "Phone Banking";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-telephone-fill text-success me-2"></i>Phone Banking</h3>
    <div class="d-flex gap-2">
        @if (Model.IsExotelEnabled)
        {
            <span class="badge bg-success align-self-center">
                <i class="bi bi-telephone-fill me-1"></i> Exotel Active
            </span>
        }
        <a asp-page="./LogCall" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Log a Call</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="fs-2 fw-bold text-primary">@Model.TotalCallsToday</div>
                <div class="text-muted small">Calls Today</div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="fs-2 fw-bold text-success">@Model.TalkedCount</div>
                <div class="text-muted small">Connected</div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="fs-2 fw-bold text-warning">@Model.NoAnswerCount</div>
                <div class="text-muted small">No Answer</div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="fs-2 fw-bold text-info">@Model.CallBackCount</div>
                <div class="text-muted small">Call Back Later</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Pending calls -->
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-list-check me-1"></i>Pending — Floating / Unknown Voters
            </div>
            <div class="list-group list-group-flush" style="max-height:460px;overflow-y:auto">
                @foreach (var v in Model.PendingCallVoters)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@v.Name</strong>
                            <span class="badge bg-secondary ms-1">B-@v.BoothNumber</span><br/>
                            <small class="text-muted">@v.MobileNumber</small>
                        </div>
                        <div class="d-flex gap-1">
                            @if (Model.IsExotelEnabled)
                            {
                                <button class="btn btn-sm btn-primary"
                                        onclick="exotelCall(@v.Id, '@v.Name')"
                                        title="Click-to-Call via Exotel">
                                    <i class="bi bi-telephone-fill"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="exotelSmsPrompt(@v.Id, '@v.Name')"
                                        title="Send SMS via Exotel">
                                    <i class="bi bi-chat-dots-fill"></i>
                                </button>
                            }
                            <a asp-page="./LogCall" asp-route-voterId="@v.Id" class="btn btn-sm btn-success" title="Log call manually">
                                <i class="bi bi-journal-text"></i>
                            </a>
                        </div>
                    </div>
                }
                @if (!Model.PendingCallVoters.Any())
                {
                    <div class="list-group-item text-muted text-center py-3">No pending voters. Great job!</div>
                }
            </div>
        </div>
    </div>

    <!-- Today's call log -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-clock-history me-1"></i>Today's Call Log
            </div>
            <div class="table-responsive" style="max-height:460px;overflow-y:auto">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Time</th>
                            <th>Voter</th>
                            <th>Outcome</th>
                            <th>Sentiment</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.TodaysCalls)
                        {
                            var ob = c.Outcome switch {
                                Nirvachak_AI.Domain.Enums.CallOutcome.Talked    => "success",
                                Nirvachak_AI.Domain.Enums.CallOutcome.CallBack  => "info text-dark",
                                Nirvachak_AI.Domain.Enums.CallOutcome.NoAnswer  => "warning text-dark",
                                Nirvachak_AI.Domain.Enums.CallOutcome.Refused   => "danger",
                                _                                                => "secondary"
                            };
                            <tr>
                                <td>@c.CalledAt.ToLocalTime().ToString("HH:mm")</td>
                                <td>@c.Voter?.Name</td>
                                <td><span class="badge bg-@ob">@c.Outcome</span></td>
                                <td>@(c.SentimentAfterCall.HasValue ? c.SentimentAfterCall.ToString() : "—")</td>
                                <td class="text-muted small">@c.Notes</td>
                            </tr>
                        }
                        @if (!Model.TodaysCalls.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No calls logged today.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ?? Exotel Click-to-Call ??????????????????????????????????????????????
    async function exotelCall(voterId, voterName) {
        if (!confirm(`Initiate Exotel call to ${voterName}?\nYour registered phone will ring first.`)) return;
        try {
            const res = await fetch('/api/exotel/call', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgery() },
                body: JSON.stringify({ voterId })
            });
            const data = await res.json();
            if (res.ok) {
                showToast(`? Call initiated to ${voterName}. Your phone will ring shortly.`, 'success');
            } else {
                showToast(`? ${data.error ?? 'Failed to initiate call.'}`, 'danger');
            }
        } catch (e) {
            showToast('? Network error. Please try again.', 'danger');
        }
    }

    // ?? Exotel SMS ????????????????????????????????????????????????????????
    async function exotelSmsPrompt(voterId, voterName) {
        const msg = prompt(`Enter SMS message to send to ${voterName}:`);
        if (!msg || !msg.trim()) return;
        try {
            const res = await fetch('/api/exotel/sms', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgery() },
                body: JSON.stringify({ voterId, message: msg.trim() })
            });
            const data = await res.json();
            if (res.ok) {
                showToast(`? SMS sent to ${voterName}.`, 'success');
            } else {
                showToast(`? ${data.error ?? 'Failed to send SMS.'}`, 'danger');
            }
        } catch (e) {
            showToast('? Network error. Please try again.', 'danger');
        }
    }

    // ?? Helpers ???????????????????????????????????????????????????????????
    function getAntiForgery() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    function showToast(message, type) {
        const id = 'exotel-toast-' + Date.now();
        const html = `<div id="${id}" class="toast align-items-center text-bg-${type} border-0 show position-fixed bottom-0 end-0 m-3" role="alert" style="z-index:9999">
            <div class="d-flex">
                <div class="toast-body">${message}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="document.getElementById('${id}').remove()"></button>
            </div>
        </div>`;
        document.body.insertAdjacentHTML('beforeend', html);
        setTimeout(() => { document.getElementById(id)?.remove(); }, 5000);
    }
</script>
}
