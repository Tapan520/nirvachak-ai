@page
@model Nirvachak_AI.Pages.Reports.ElectionDayModel
@{
    ViewData["Title"] = "Election Day Report";
    Layout = null; // standalone printable page
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Election Day Report - @Model.ConstituencyName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { font-size: 13px; background: #fff; }

        .report-header { border-bottom: 2px solid #1a1f2e; padding-bottom: 10px; margin-bottom: 16px; }
        .report-header h3 { color: #1a1f2e; margin: 0; }
        .report-header .meta { color: #6c757d; font-size: 0.8rem; }

        .kpi-box { border: 1px solid #dee2e6; border-radius: 8px; padding: 12px 16px; text-align: center; }
        .kpi-box .kpi-value { font-size: 1.8rem; font-weight: 700; }
        .kpi-box .kpi-label { font-size: 0.78rem; color: #6c757d; }

        .section-title { font-size: 0.85rem; font-weight: 700; text-transform: uppercase;
                         letter-spacing: 0.06em; color: #495057; border-bottom: 1px solid #e9ecef;
                         padding-bottom: 4px; margin-bottom: 10px; }

        table { font-size: 0.82rem; }
        .progress { height: 8px; border-radius: 4px; }

        .no-print { display: block; }
        @@media print {
            .no-print { display: none !important; }
            body { font-size: 11px; }
            @@page { size: A4 portrait; margin: 12mm 10mm; }
            .page-break { page-break-before: always; }
            a { color: inherit !important; text-decoration: none !important; }
        }
    </style>
</head>
<body class="p-4">

    @* Print / Back buttons *@
    <div class="no-print d-flex gap-2 mb-3">
        <button onclick="window.print()" class="btn btn-primary btn-sm">
            <i class="bi bi-printer me-1"></i>Print / Save PDF
        </button>
        <a asp-page="/ElectionDay/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Election Day
        </a>
        @if (Model.IsAdmin && Model.Constituencies.Any())
        {
            <form method="get" class="d-flex align-items-center gap-2 ms-3">
                <select name="ConstituencyFilter" class="form-select form-select-sm" style="max-width:220px" onchange="this.form.submit()">
                    @foreach (var c in Model.Constituencies)
                    {
                        <option value="@c.Id" selected="@(Model.ConstituencyFilter == c.Id)">@c.Name</option>
                    }
                </select>
            </form>
        }
    </div>

    @* Report header *@
    <div class="report-header">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h3><i class="bi bi-activity me-2"></i>Election Day Live Report</h3>
                <div class="meta">Constituency: <strong>@Model.ConstituencyName</strong> &nbsp;|&nbsp; Generated: @Model.GeneratedAt.ToString("dd MMM yyyy, h:mm tt")</div>
            </div>
            <div class="text-end meta">
                <div class="fw-bold text-success" style="font-size:1rem;">? LIVE</div>
            </div>
        </div>
    </div>

    @* KPI row *@
    <div class="row g-3 mb-4">
        <div class="col-3">
            <div class="kpi-box">
                <div class="kpi-value text-primary">@Model.TotalVoters.ToString("N0")</div>
                <div class="kpi-label">Total Eligible Voters</div>
            </div>
        </div>
        <div class="col-3">
            <div class="kpi-box">
                <div class="kpi-value text-success">@Model.TotalVoted.ToString("N0")</div>
                <div class="kpi-label">Voted So Far</div>
            </div>
        </div>
        <div class="col-3">
            <div class="kpi-box">
                <div class="kpi-value @(Model.OverallPercent >= 60 ? "text-success" : Model.OverallPercent >= 40 ? "text-warning" : "text-danger")">
                    @Model.OverallPercent.ToString("F1")%
                </div>
                <div class="kpi-label">Overall Turnout</div>
            </div>
        </div>
        <div class="col-3">
            <div class="kpi-box">
                <div class="kpi-value text-danger">@Model.FavourNotVoted.ToString("N0")</div>
                <div class="kpi-label">Favour Voters Pending</div>
            </div>
        </div>
    </div>

    @* Booth-wise turnout table *@
    <div class="section-title"><i class="bi bi-geo-alt me-1"></i>Booth-wise Turnout</div>
    <table class="table table-bordered table-sm mb-4">
        <thead class="table-dark">
            <tr>
                <th>Booth #</th>
                <th>Booth Name</th>
                <th class="text-end">Total Voters</th>
                <th class="text-end">Voted</th>
                <th class="text-end">Turnout %</th>
                <th style="min-width:120px">Progress</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var b in Model.BoothTurnout)
        {
            <tr>
                <td class="fw-bold">#@b.BoothNumber</td>
                <td>@b.BoothName</td>
                <td class="text-end">@b.TotalVoters</td>
                <td class="text-end fw-bold text-success">@b.VotedCount</td>
                <td class="text-end fw-bold @(b.TurnoutPercent >= 60 ? "text-success" : b.TurnoutPercent >= 40 ? "text-warning" : "text-danger")">
                    @b.TurnoutPercent%
                </td>
                <td>
                    <div class="progress">
                        <div class="progress-bar @(b.TurnoutPercent >= 60 ? "bg-success" : b.TurnoutPercent >= 40 ? "bg-warning" : "bg-danger")"
                             style="width:@b.TurnoutPercent%"></div>
                    </div>
                </td>
            </tr>
        }
        @if (!Model.BoothTurnout.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No booth data available.</td></tr>
        }
        </tbody>
        <tfoot class="table-light fw-bold">
            <tr>
                <td colspan="2">Total</td>
                <td class="text-end">@Model.TotalVoters</td>
                <td class="text-end text-success">@Model.TotalVoted</td>
                <td class="text-end">@Model.OverallPercent.ToString("F1")%</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    @* Chase list *@
    <div class="page-break"></div>
    <div class="section-title mt-4"><i class="bi bi-person-exclamation me-1 text-danger"></i>Chase List - Favour Voters Not Yet Voted (@Model.ChaseList.Count)</div>
    @if (!Model.ChaseList.Any())
    {
        <div class="alert alert-success py-2 small"><i class="bi bi-check2-all me-1"></i>All tracked Favour voters have voted!</div>
    }
    else
    {
        <table class="table table-bordered table-sm">
            <thead class="table-dark">
                <tr><th>#</th><th>Name</th><th>EPIC</th><th>Booth</th><th>Ward</th><th>Mobile</th><th>Address</th></tr>
            </thead>
            <tbody>
            @{ int idx = 1; }
            @foreach (var v in Model.ChaseList)
            {
                <tr>
                    <td class="text-muted">@(idx++)</td>
                    <td class="fw-semibold">@v.Name</td>
                    <td class="font-monospace small">@v.VoterId</td>
                    <td><span class="badge bg-secondary">#@v.BoothNumber</span></td>
                    <td>@(v.WardNumber ?? "-")</td>
                    <td class="small">@(v.MobileNumber ?? "-")</td>
                    <td class="small text-muted">@v.Address</td>
                </tr>
            }
            </tbody>
        </table>
    }

    <div class="mt-4 text-muted small text-center no-print">
        Report generated by Nirvachak AI &mdash; @Model.GeneratedAt.ToString("dd MMM yyyy, h:mm tt")
    </div>

</body>
</html>
