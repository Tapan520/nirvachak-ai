@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Nirvachak_AI.Domain.Entities
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject Nirvachak_AI.Infrastructure.Data.AppDbContext LayoutDb
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nirvachak AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#3b5bdb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ElectionTool" />
</head>
<body class="d-flex flex-column min-vh-100">

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    int annUnread = 0;
    if (currentUser != null)
    {
        var roleStr = currentUser.Role.ToString();
        var now = DateTime.UtcNow;
        var ackedIds = await LayoutDb.AnnouncementAcknowledgements
            .Where(ack => ack.UserId == currentUser.Id)
            .Select(ack => ack.AnnouncementId)
            .ToListAsync();
        annUnread = await LayoutDb.Announcements.CountAsync(a =>
            a.IsActive
            && a.RequiresAcknowledgement
            && (a.ExpiresAt == null || a.ExpiresAt > now)
            && (a.ConstituencyId == null || a.ConstituencyId == currentUser.ConstituencyId)
            && (a.TargetRoles == "All" || a.TargetRoles.Contains(roleStr))
            && !ackedIds.Contains(a.Id));
    }
    bool isSuperAdmin      = User.IsInRole("SuperAdmin");
    bool isAdmin           = User.IsInRole("Admin");
    bool isCampaignManager = User.IsInRole("CampaignManager");
    bool isManagementRole  = isSuperAdmin || isAdmin || isCampaignManager;
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar d-flex flex-column">
            <div class="sidebar-header px-3 py-3 border-bottom border-secondary">
                <div class="d-flex align-items-center">
                    <i class="bi bi-bar-chart-fill text-warning fs-4 me-2"></i>
                    <div>
                        <div class="fw-bold text-white small">Nirvachak AI</div>
                        <div class="text-muted" style="font-size:0.7rem;">Management Tool</div>
                    </div>
                </div>
            </div>
            <div class="sidebar-body flex-grow-1 overflow-auto py-2">
                @{
                    bool votersOpen      = currentPage.StartsWith("/Voters") || currentPage == "/VoterSlips/Index";
                        bool campaignOpen    = currentPage.StartsWith("/PhoneBanking") || currentPage.StartsWith("/Influencers") || currentPage.StartsWith("/Competitor") || currentPage.StartsWith("/Campaign") || currentPage.StartsWith("/Volunteers") || currentPage.StartsWith("/Leaderboard");
                        bool operationsOpen  = currentPage.StartsWith("/Announcements") || currentPage.StartsWith("/ElectionDay") || currentPage.StartsWith("/Analytics") || currentPage.StartsWith("/Predictions") || currentPage.StartsWith("/WinProbability") || currentPage.StartsWith("/SwingVoters") || currentPage.StartsWith("/Grievances") || currentPage.StartsWith("/Expenses") || currentPage.StartsWith("/Surveys") || currentPage.StartsWith("/Transport") || currentPage.StartsWith("/Reports");
                    bool electionOpsOpen = currentPage.StartsWith("/PannaPramukh") || currentPage.StartsWith("/BoothShifts") || currentPage.StartsWith("/RapidResponse") || currentPage.StartsWith("/Broadcast") || currentPage.StartsWith("/Budget") || currentPage.StartsWith("/Results") || currentPage.StartsWith("/FieldReports");
                    bool managementOpen  = currentPage.StartsWith("/Admin") || currentPage.StartsWith("/Booths");
                }
                <ul class="nav flex-column px-2">
                    <!-- Dashboard (standalone) -->
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentPage == "/Dashboard/Index" ? "active" : "")" asp-page="/Dashboard/Index">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>

                    <!-- VOTERS -->
                    <li class="nav-item mt-2">
                        <button class="sidebar-section-toggle @(votersOpen ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sec-voters" aria-expanded="@votersOpen.ToString().ToLower()">
                            <span><i class="bi bi-people-fill me-2"></i>VOTERS</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                    </li>
                </ul>
                <div class="collapse @(votersOpen ? "show" : "")" id="sec-voters">
                    <ul class="nav flex-column px-2 sidebar-submenu">
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Voters/Index") ? "active" : "")" asp-page="/Voters/Index">
                                <i class="bi bi-people-fill me-2"></i> Voter List
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage == "/Voters/Create" ? "active" : "")" asp-page="/Voters/Create">
                                <i class="bi bi-person-plus-fill me-2"></i> Add Voter
                            </a>
                        </li>
                        @if (currentUser?.Role != Nirvachak_AI.Domain.Enums.UserRole.FieldWorker && currentUser?.Role != Nirvachak_AI.Domain.Enums.UserRole.BoothAgent)
                        {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage == "/Voters/Import" ? "active" : "")" asp-page="/Voters/Import">
                                <i class="bi bi-upload me-2"></i> Import Voters
                            </a>
                        </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage == "/VoterSlips/Index" ? "active" : "")" asp-page="/VoterSlips/Index">
                                <i class="bi bi-printer-fill me-2"></i> Voter Slips
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- CAMPAIGN -->
                <ul class="nav flex-column px-2">
                    <li class="nav-item mt-1">
                        <button class="sidebar-section-toggle @(campaignOpen ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sec-campaign" aria-expanded="@campaignOpen.ToString().ToLower()">
                            <span><i class="bi bi-calendar-event-fill me-2"></i>CAMPAIGN</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                    </li>
                </ul>
                <div class="collapse @(campaignOpen ? "show" : "")" id="sec-campaign">
                    <ul class="nav flex-column px-2 sidebar-submenu">
                        @if (User.IsInRole("Admin") || User.IsInRole("CampaignManager") || User.IsInRole("Candidate") || User.IsInRole("FieldWorker") || User.IsInRole("BoothAgent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(currentPage.StartsWith("/PhoneBanking") ? "active" : "")" asp-page="/PhoneBanking/Index">
                                    <i class="bi bi-telephone-fill me-2"></i> Phone Banking
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("CampaignManager") || User.IsInRole("Candidate"))
                        {
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(currentPage.StartsWith("/Influencers") ? "active" : "")" asp-page="/Influencers/Index">
                                    <i class="bi bi-people-fill me-2"></i> Influencer Network
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(currentPage.StartsWith("/Competitor") ? "active" : "")" asp-page="/Competitor/Index">
                                    <i class="bi bi-eye-fill me-2"></i> Competitor Intel
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Campaign") ? "active" : "")" asp-page="/Campaign/Index">
                                <i class="bi bi-calendar-event-fill me-2"></i> Campaign Events
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Volunteers") ? "active" : "")" asp-page="/Volunteers/Index">
                                <i class="bi bi-person-check-fill me-2"></i> Volunteers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Leaderboard") ? "active" : "")" asp-page="/Leaderboard/Index">
                                <i class="bi bi-trophy-fill me-2 text-warning"></i> Leaderboard
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- OPERATIONS -->
                <ul class="nav flex-column px-2">
                    <li class="nav-item mt-1">
                        <button class="sidebar-section-toggle @(operationsOpen ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sec-operations" aria-expanded="@operationsOpen.ToString().ToLower()">
                            <span><i class="bi bi-gear-fill me-2"></i>OPERATIONS</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                    </li>
                </ul>
                <div class="collapse @(operationsOpen ? "show" : "")" id="sec-operations">
                    <ul class="nav flex-column px-2 sidebar-submenu">
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Announcements") ? "active" : "")" asp-page="/Announcements/Index">
                                <i class="bi bi-megaphone-fill me-2"></i> Announcements
                                @if (annUnread > 0)
                                {
                                    <span class="badge bg-warning text-dark ms-auto">@annUnread</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage == "/ElectionDay/Index" ? "active" : "")" asp-page="/ElectionDay/Index">
                                <i class="bi bi-activity me-2"></i> Election Day
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage == "/ElectionDay/Checklist" ? "active" : "")" asp-page="/ElectionDay/Checklist">
                                <i class="bi bi-clipboard2-check me-2"></i> Booth Checklist
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Analytics") && !currentPage.StartsWith("/Analytics/SurveyDemographics") && !currentPage.StartsWith("/Analytics/EditVoterSurvey") ? "active" : "")" asp-page="/Analytics/Index">
                                <i class="bi bi-bar-chart-line-fill me-2"></i> Analytics
                            </a>
                        </li>
                        @if (isSuperAdmin || User.IsInRole("Admin") || User.IsInRole("CampaignManager") || User.IsInRole("Candidate"))
                        {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Predictions") ? "active" : "")" asp-page="/Predictions/Index">
                                <i class="bi bi-graph-up-arrow me-2"></i> Predictive Analytics
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/WinProbability") ? "active" : "")" asp-page="/WinProbability/Index">
                                <i class="bi bi-trophy-fill me-2"></i> Win Probability
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/SwingVoters") ? "active" : "")" asp-page="/SwingVoters/Index">
                                <i class="bi bi-arrow-left-right me-2 text-warning"></i> Swing Voters
                            </a>
                        </li>
                        }
                        @if (currentUser?.Role != Nirvachak_AI.Domain.Enums.UserRole.FieldWorker && currentUser?.Role != Nirvachak_AI.Domain.Enums.UserRole.BoothAgent)
                        {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Grievances") ? "active" : "")" asp-page="/Grievances/Index">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> Grievances
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Expenses") ? "active" : "")" asp-page="/Expenses/Index">
                                <i class="bi bi-cash-coin me-2"></i> Expenses
                            </a>
                        </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Surveys") ? "active" : "")" asp-page="/Surveys/Index">
                                <i class="bi bi-clipboard2-data-fill me-2"></i> Surveys &amp; Feedback
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Analytics/SurveyDemographics") || currentPage.StartsWith("/Analytics/EditVoterSurvey") ? "active" : "")" asp-page="/Analytics/SurveyDemographics">
                                <i class="bi bi-person-check-fill me-2"></i> Voter Consent Analytics
                            </a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("CampaignManager") || User.IsInRole("Candidate"))
                        {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Transport") ? "active" : "")" asp-page="/Transport/Index">
                                <i class="bi bi-truck me-2"></i> Voter Transport
                            </a>
                        </li>
                        }
                        @if (currentUser?.Role != Nirvachak_AI.Domain.Enums.UserRole.FieldWorker && currentUser?.Role != Nirvachak_AI.Domain.Enums.UserRole.BoothAgent)
                        {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Reports") ? "active" : "")" asp-page="/Reports/Export">
                                <i class="bi bi-file-earmark-arrow-down me-2 text-success"></i> Export Reports
                            </a>
                        </li>
                        }
                    </ul>
                </div>

                <!-- ELECTION OPS -->
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("CampaignManager") || User.IsInRole("Candidate"))
                {
                <ul class="nav flex-column px-2">
                    <li class="nav-item mt-1">
                        <button class="sidebar-section-toggle @(electionOpsOpen ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sec-electionops" aria-expanded="@electionOpsOpen.ToString().ToLower()">
                            <span><i class="bi bi-flag-fill me-2"></i>ELECTION OPS</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                    </li>
                </ul>
                <div class="collapse @(electionOpsOpen ? "show" : "")" id="sec-electionops">
                    <ul class="nav flex-column px-2 sidebar-submenu">
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/PannaPramukh") ? "active" : "")" asp-page="/PannaPramukh/Index">
                                <i class="bi bi-journals me-2"></i> Panna Pramukh
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/BoothShifts") ? "active" : "")" asp-page="/BoothShifts/Index">
                                <i class="bi bi-calendar2-check-fill me-2"></i> Booth Shift Planner
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/RapidResponse") ? "active" : "")" asp-page="/RapidResponse/Index">
                                <i class="bi bi-lightning-charge-fill me-2"></i> Rapid Response
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Broadcast") ? "active" : "")" asp-page="/Broadcast/Index">
                                <i class="bi bi-whatsapp me-2"></i> Broadcast
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Budget") ? "active" : "")" asp-page="/Budget/Index">
                                <i class="bi bi-wallet2 me-2"></i> Budget Planner
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Results") ? "active" : "")" asp-page="/Results/Index">
                                <i class="bi bi-trophy-fill me-2"></i> Result Day
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/FieldReports") ? "active" : "")" asp-page="/FieldReports/Index">
                                <i class="bi bi-clipboard2-check-fill me-2"></i> Field Reports
                            </a>
                        </li>
                    </ul>
                </div>
                }
                @* Field Reports for non-election-ops roles *@
                @if (!(User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("CampaignManager") || User.IsInRole("Candidate")))
                {
                <ul class="nav flex-column px-2">
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentPage.StartsWith("/FieldReports") ? "active" : "")" asp-page="/FieldReports/Index">
                            <i class="bi bi-clipboard2-check-fill me-2"></i> Field Reports
                        </a>
                    </li>
                </ul>
                }

                <!-- MANAGEMENT -->
                @if (isManagementRole)
                {
                <ul class="nav flex-column px-2">
                    <li class="nav-item mt-1">
                        <button class="sidebar-section-toggle @(managementOpen ? "" : "collapsed")" data-bs-toggle="collapse" data-bs-target="#sec-management" aria-expanded="@managementOpen.ToString().ToLower()">
                            <span><i class="bi bi-shield-lock-fill me-2"></i>MANAGEMENT</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                    </li>
                </ul>
                <div class="collapse @(managementOpen ? "show" : "")" id="sec-management">
                    <ul class="nav flex-column px-2 sidebar-submenu">
                        @if (isSuperAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link sidebar-link @(currentPage.StartsWith("/Admin/Constituencies") ? "active" : "")" asp-page="/Admin/Constituencies/Index">
                                    <i class="bi bi-geo-fill me-2"></i> Constituencies
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Admin/Wards") ? "active" : "")" asp-page="/Admin/Wards/Index">
                                <i class="bi bi-map me-2"></i> Wards
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Booths") ? "active" : "")" asp-page="/Booths/Index">
                                <i class="bi bi-geo-alt-fill me-2"></i> Booths
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Admin") && !currentPage.StartsWith("/Admin/Constituencies") && !currentPage.StartsWith("/Admin/Wards") && !currentPage.StartsWith("/Admin/Rewards") && !currentPage.StartsWith("/Admin/Exotel") ? "active" : "")" asp-page="/Admin/Index">
                                <i class="bi bi-people me-2"></i> Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Admin/Rewards") ? "active" : "")" asp-page="/Admin/Rewards/Index">
                                <i class="bi bi-gift-fill me-2"></i> Rewards
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage.StartsWith("/Admin/Exotel") ? "active" : "")" asp-page="/Admin/Exotel/Index">
                                <i class="bi bi-telephone-fill me-2"></i> Exotel (Call &amp; SMS)
                            </a>
                        </li>
                        @if (isSuperAdmin)
                        {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link @(currentPage == "/Admin/Backup" ? "active" : "")" asp-page="/Admin/Backup">
                                <i class="bi bi-shield-check me-2 text-success"></i> DB Backup
                            </a>
                        </li>
                        }
                    </ul>
                </div>
                }
            </div>
            <div class="sidebar-footer px-3 py-2 border-top border-secondary">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="small text-white">
                        <i class="bi bi-person-circle me-1"></i>
                        @currentUser?.FullName
                        <br/><span class="text-muted" style="font-size:0.7rem;">@currentUser?.Role</span>
                    </div>
                    <div class="d-flex gap-1">
                        <a asp-page="/Account/ManageTwoFactor" class="btn btn-sm btn-outline-info" title="Two-Factor Authentication">
                            <i class="bi bi-shield-lock"></i>
                        </a>
                        <form method="post" asp-page="/Account/Logout">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
        <!-- Page content -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <nav class="navbar navbar-expand navbar-light bg-white border-bottom px-3 py-2">
                <button class="btn btn-sm btn-outline-secondary me-3" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
                <span class="navbar-text fw-semibold text-dark">@ViewData["Title"]</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="badge bg-success">Live</span>
                    <small class="text-muted">@DateTime.Now.ToString("dd MMM yyyy")</small>
                </div>
            </nav>
            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
