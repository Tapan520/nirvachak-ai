@page
@model Nirvachak_AI.Pages.Transport.AddRequestModel
@{ ViewData["Title"] = "Add Transport Request"; }

<div class="d-flex align-items-center mb-4">
    <a asp-page="/Transport/Index" class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
    <h4 class="mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Transport Request</h4>
</div>

@if (Model.IsAdmin && Model.Constituencies.Any())
{
    <div class="card border-0 shadow-sm mb-3" style="max-width:700px">
        <div class="card-body py-2">
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
                <label class="fw-semibold text-nowrap small">Constituency:</label>
                <select name="SelectedConstituencyId" class="form-select form-select-sm"
                        onchange="this.form.submit()" style="max-width:280px">
                    <option value="">-- Select Constituency --</option>
                    @foreach (var c in Model.Constituencies)
                    {
                        <option value="@c.Id" selected="@(Model.SelectedConstituencyId == c.Id)">@c.Name</option>
                    }
                </select>
                @if (!string.IsNullOrWhiteSpace(Model.SearchVoter))
                {
                    <input type="hidden" name="SearchVoter" value="@Model.SearchVoter" />
                }
            </form>
        </div>
    </div>
}

<div class="card border-0 shadow-sm mb-3" style="max-width:700px">
    <div class="card-body">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="SearchVoter" class="form-control" placeholder="Search voter by name, EPIC or mobile-" value="@Model.SearchVoter" />
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
        </form>
        @if (Model.SearchResults.Any())
        {
            <div class="mt-2 border rounded">
                @foreach (var v in Model.SearchResults)
                {
                    <a href="?voterId=@v.Id&SearchVoter=@Model.SearchVoter" class="d-block p-2 text-decoration-none text-dark border-bottom hover-bg">
                        <strong>@v.Name</strong> &middot; @v.VoterId &middot; Booth @v.BoothNumber
                        <small class="text-muted ms-2">@v.MobileNumber</small>
                    </a>
                }
            </div>
        }
    </div>
</div>

@{
    int? preselectedVoterId = null;
    if (int.TryParse(Request.Query["voterId"], out int pid)) preselectedVoterId = pid;
}

<div class="card border-0 shadow-sm" style="max-width:700px">
    <div class="card-body">
        <form method="post">
            @if (Model.IsAdmin)
            {
                <input type="hidden" name="SelectedConstituencyId" value="@Model.SelectedConstituencyId" />
            }
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Voter ID <span class="text-danger">*</span></label>
                    <input asp-for="Request.VoterId" type="number" class="form-control" value="@preselectedVoterId" required />
                    <div class="form-text">Use search above to find voter, then enter their ID</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Pickup Address <span class="text-danger">*</span></label>
                    <input asp-for="Request.PickupAddress" class="form-control" placeholder="House no, street, landmark" required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Additional Notes</label>
                    <textarea asp-for="Request.PickupNotes" class="form-control" rows="2" placeholder="Special needs, mobility issues, etc."></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Submit Request</button>
                <a asp-page="/Transport/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
