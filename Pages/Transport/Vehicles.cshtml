@page
@model Nirvachak_AI.Pages.Transport.VehiclesModel
@{ ViewData["Title"] = "Transport Vehicles"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0"><i class="bi bi-truck me-2 text-primary"></i>Transport Vehicles</h4>
        <small class="text-muted">Register and manage Election Day transport vehicles</small>
    </div>
    <a asp-page="/Transport/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Transport</a>
</div>

@if (TempData["Message"] != null)
{ <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-1"></i>@TempData["Message"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold"><i class="bi bi-plus-circle me-1"></i>Add Vehicle</div>
            <div class="card-body">
                <form method="post" asp-page-handler="AddVehicle">
                    @if (Model.IsAdmin)
                    {
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Constituency</label>
                            <select asp-for="NewVehicle.ConstituencyId" class="form-select form-select-sm">
                                @foreach (var c in Model.Constituencies) { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </div>
                    }
                    else { <input type="hidden" asp-for="NewVehicle.ConstituencyId" /> }
                    <div class="mb-2"><label class="form-label fw-semibold">Driver Name *</label><input asp-for="NewVehicle.DriverName" class="form-control form-control-sm" required /></div>
                    <div class="mb-2"><label class="form-label fw-semibold">Driver Phone *</label><input asp-for="NewVehicle.DriverPhone" class="form-control form-control-sm" required /></div>
                    <div class="mb-2"><label class="form-label fw-semibold">Vehicle Number</label><input asp-for="NewVehicle.VehicleNumber" class="form-control form-control-sm" /></div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Vehicle Type</label>
                        <select asp-for="NewVehicle.VehicleType" class="form-select form-select-sm">
                            <option>Auto</option><option>Car</option><option>Van</option><option>Bus</option><option>Other</option>
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label fw-semibold">Capacity (persons)</label><input asp-for="NewVehicle.Capacity" type="number" class="form-control form-control-sm" value="4" /></div>
                    <div class="mb-3"><label class="form-label fw-semibold">Booth Number</label><input asp-for="NewVehicle.BoothNumber" type="number" class="form-control form-control-sm" /></div>
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg me-1"></i>Add Vehicle</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold"><i class="bi bi-list me-1"></i>Registered Vehicles (@Model.Vehicles.Count)</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th>Driver</th><th>Vehicle</th><th>Type</th><th>Cap.</th><th>Booth</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var v in Model.Vehicles)
                        {
                            <tr>
                                <td><strong>@v.DriverName</strong><br/><small>@v.DriverPhone</small></td>
                                <td>@v.VehicleNumber</td><td>@v.VehicleType</td><td>@v.Capacity</td>
                                <td><span class="badge bg-secondary">@v.BoothNumber</span></td>
                                <td>
                                    <form method="post" class="d-inline"><input type="hidden" name="id" value="@v.Id"/>
                                        <button asp-page-handler="Toggle" class="btn btn-sm @(v.IsAvailable?"btn-success":"btn-outline-secondary")">@(v.IsAvailable?"Available":"Busy")</button>
                                    </form>
                                </td>
                                <td>
                                    <form method="post" class="d-inline"><input type="hidden" name="id" value="@v.Id"/>
                                        <button asp-page-handler="DeleteVehicle" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Vehicles.Any())
                        { <tr><td colspan="7" class="text-center text-muted py-3">No vehicles registered.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
