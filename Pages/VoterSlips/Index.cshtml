@page
@model Nirvachak_AI.Pages.VoterSlips.IndexModel
@{
    ViewData["Title"] = "Voter Slips";
    var filterLabel = Model.BoothFilter.HasValue ? $"Booth {Model.BoothFilter}" :
                      Model.ConstituencyFilter.HasValue ? "Selected Constituency" : "All";
}

@* ?? Toolbar (hidden on print) ????????????????????????????????????????????? *@
<div class="no-print">
    <div class="row align-items-end g-2 mb-3">
        <div class="col-auto">
            <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
                @if (Model.IsAdmin)
                {
                    <div>
                        <label class="form-label form-label-sm mb-1 fw-semibold">Constituency</label>
                        <select asp-for="ConstituencyFilter" class="form-select form-select-sm" style="min-width:180px" onchange="this.form.submit()">
                            <option value="">All Constituencies</option>
                            @foreach (var c in Model.Constituencies)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                }
                <div>
                    <label class="form-label form-label-sm mb-1 fw-semibold">Booth</label>
                    <select asp-for="BoothFilter" class="form-select form-select-sm" style="min-width:130px">
                        <option value="">All Booths</option>
                        @foreach (var b in Model.BoothNumbers)
                        {
                            <option value="@b">Booth @b</option>
                        }
                    </select>
                </div>
                <div class="align-self-end">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-funnel me-1"></i>Apply
                    </button>
                    @if (Model.BoothFilter.HasValue || Model.ConstituencyFilter.HasValue)
                    {
                        <a href="?" class="btn btn-outline-secondary btn-sm ms-1">Clear</a>
                    }
                </div>
            </form>
        </div>

        @* Column-count toggle *@
        <div class="col-auto ms-auto d-flex align-items-end gap-2">
            @* Language toggle *@
            <div>
                <label class="form-label form-label-sm mb-1 fw-semibold d-block">Language</label>
                <div class="btn-group btn-group-sm" role="group">
                    <input type="radio" class="btn-check" name="langToggle" id="langEn" autocomplete="off" checked onchange="switchLang('en')">
                    <label class="btn btn-outline-secondary" for="langEn">English</label>
                    <input type="radio" class="btn-check" name="langToggle" id="langHi" autocomplete="off" onchange="switchLang('hi')">
                    <label class="btn btn-outline-secondary" for="langHi">हिंदी</label>
                </div>
                <span id="langSpinner" class="spinner-border spinner-border-sm text-primary ms-1 align-self-center" role="status" style="display:none;" title="Translating..."></span>
            </div>
            <div>
                <label class="form-label form-label-sm mb-1 fw-semibold">Columns</label>
                <div class="btn-group btn-group-sm" role="group" id="colToggle">
                    <button type="button" class="btn btn-outline-secondary" onclick="setColumns(2)" id="col2Btn">2</button>
                    <button type="button" class="btn btn-primary active"    onclick="setColumns(3)" id="col3Btn">3</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="setColumns(4)" id="col4Btn">4</button>
                </div>
            </div>
            <button onclick="window.print()" class="btn btn-success btn-sm">
                <i class="bi bi-printer-fill me-1"></i>Print / PDF
                <span class="badge bg-white text-success ms-1">@Model.Voters.Count</span>
            </button>
        </div>
    </div>

    @if (Model.Voters.Any())
    {
        <div class="alert alert-info py-2 mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-info-circle-fill"></i>
            <span>Showing <strong>@Model.Voters.Count</strong> slip(s) - <strong>@filterLabel</strong>.
            Use <strong>Print / PDF</strong> to print or save as PDF in
            <strong><span id="colCountLabel">3</span>-column</strong> layout.</span>
        </div>
    }
</div>

@* ?? Print header (visible only on print) ????????????????????????????????? *@
<div class="print-header" style="display:none">
    <table style="width:100%; font-size:8pt;">
        <tr>
            <td style="font-weight:700; font-size:10pt;">Voter Slips - @filterLabel</td>
            <td style="text-align:right; color:#555;">@DateTime.Now.ToString("dd MMM yyyy, hh:mm tt") &nbsp;|&nbsp; Total: @Model.Voters.Count</td>
        </tr>
    </table>
</div>

@* ?? Slip grid ????????????????????????????????????????????????????????????? *@
<div class="slip-grid-outer">
<div class="row g-0" id="slipContainer">
    @foreach (var v in Model.Voters)
    {
        var booth = Model.Booths.FirstOrDefault(b => b.BoothNumber == v.BoothNumber);
        var boothAddr = booth != null && !string.IsNullOrEmpty(booth.Address)
                        ? $"Booth {v.BoothNumber} \u2013 {booth.Address}"
                        : $"Booth {v.BoothNumber}";
        <div class="col-4 slip-col" id="slipWrap_@v.Id">
            <div class="voter-slip-card border border-dark rounded p-2">
                <div class="d-flex gap-1 align-items-start">
                    <div class="flex-grow-1 overflow-hidden">

                        @* Row 1: Sr | Ward No | Panna *@
                        <div style="font-size:0.78rem; color:#111; line-height:1.35;">
                            <span class="slip-label" data-en="Sr:" data-hi="क्र.सं:" style="font-weight:700;">Sr:&nbsp;</span>@v.SerialNumber
                            &nbsp;
                            <span class="slip-label" data-en="Ward No:" data-hi="वार्ड:" style="font-weight:700;">Ward No:</span>@(v.WardNumber ?? "-")
                            &nbsp;
                            <span class="slip-label" data-en="Panna:" data-hi="पन्ना:" style="font-weight:700;">Panna:&nbsp;</span>@(v.PannaNumber ?? "-")
                        </div>

                        @* Row 2: EPIC | Age | Gender *@
                        <div style="font-size:0.78rem; color:#111; line-height:1.35;">
                            <span class="slip-label" data-en="EPIC:" data-hi="क्रमांक:" style="font-weight:700;">EPIC:&nbsp;</span><span class="font-monospace">@v.VoterId</span>
                            &nbsp;
                            <span class="slip-label" data-en="Age:" data-hi="आयु:" style="font-weight:700;">Age:&nbsp;</span>@(v.Age > 0 ? v.Age.ToString() : "-") @(v.Gender ?? "-")
                        </div>

                        @* Row 3: Name *@
                        <div style="font-size:0.80rem; color:#000; line-height:1.35;">
                            <span class="slip-label" data-en="Name:" data-hi="नाम:" style="font-weight:700;">Name:&nbsp;</span>
                            <span class="slip-val" data-en="@v.Name" @(!string.IsNullOrEmpty(v.NameLocal) ? $"data-hi-preset=\"{v.NameLocal}\"" : "")>@v.Name</span>
                            @if (!string.IsNullOrEmpty(v.NameLocal))
                            {
                                <span> (@v.NameLocal)</span>
                            }
                        </div>

                        @* Row 4: S/O or W/O *@
                        @{
                            var rel   = v.Gender == "F" ? (v.Age < 30 ? "D/O" : "W/O") : "S/O";
                            var relHi = v.Gender == "F" ? (v.Age < 30 ? "पुत्री:" : "पत्नी:") : "पुत्र:";
                        }
                        <div style="font-size:0.78rem; color:#111; line-height:1.35;">
                            <span class="slip-label"
                                  data-en="@(rel):"
                                  data-hi="@relHi"
                                  style="font-weight:700;">@rel:&nbsp;</span>
                            <span class="slip-val" data-en="@(v.FatherHusbandName ?? "-")">@(v.FatherHusbandName ?? "-")</span>
                        </div>

                        @* Row 5: Voter Address *@
                        <div style="font-size:0.76rem; color:#111; line-height:1.35;">
                            <span class="slip-label" data-en="Address:" data-hi="पता:" style="font-weight:700;">Address:&nbsp;</span>
                            <span class="slip-val" data-en="@(v.Address ?? "-")">@(v.Address ?? "-")</span>
                        </div>

                        @* Thick separator between Voter Address and Booth Address *@
                        <hr style="border:none; border-top:2.5px solid #000; margin:3px 0;" />

                        @* Row 6: Booth Address *@
                        <div style="font-size:0.76rem; color:#111; line-height:1.35;">
                            <span class="slip-label" data-en="Booth Address:" data-hi="मतदान केंद्र:" style="font-weight:700;">Booth Address:&nbsp;</span>
                            <span class="slip-val" data-en="@boothAddr">@boothAddr</span>
                        </div>

                    </div>
                    @if (!string.IsNullOrEmpty(Model.GetQrCode(v.Id)))
                    {
                        <img src="data:image/png;base64,@Model.GetQrCode(v.Id)"
                             width="44" height="44" alt="QR"
                             style="flex-shrink:0; border:1px solid #333; border-radius:3px" />
                    }
                </div>
            </div>
        </div>
    }
    @if (!Model.Voters.Any())
    {
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No voters found. Import voters first or adjust the filters.
        </div>
    }
</div>
</div>

@* Dynamic print-column style - updated by setColumns() before window.print() *@
<style id="printColStyle">
    @@media print {
        .slip-col {
            width: 33.333% !important;
            max-width: 33.333% !important;
            flex: 0 0 33.333% !important;
        }
        .voter-slip-card {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color: #000 !important;
            border-color: #000 !important;
        }
        .voter-slip-card * {
            color: #000 !important;
        }
        .voter-slip-card .slip-label {
            font-weight: 700 !important;
        }
    }
</style>

@* Cut-line styles (screen + print) *@
<style>
    /* Each slip cell gets dashed cut borders on all sides */
    .slip-col {
        border-right:  1.5px dashed #aaa;
        border-bottom: 1.5px dashed #aaa;
        padding: 6px 8px;
    }
    /* Remove right border from last column in each row */
    .slip-col:nth-child(3n) {
        border-right: none;
    }

    @@media print {
        .slip-grid-outer {
            border-top:  1.5px dashed #000;
            border-left: 1.5px dashed #000;
        }
        .slip-col {
            border-right:  1.5px dashed #000 !important;
            border-bottom: 1.5px dashed #000 !important;
            padding: 6px 8px !important;
        }
        /* nth-child rule overridden per column count by JS */
    }
</style>

@section Scripts {
<script>
    const colClasses = { 2: 'col-6', 3: 'col-4', 4: 'col-3' };
    const colWidths  = { 2: '50%',   3: '33.333%', 4: '25%'  };
    const colFontPt  = { 2: '8.5pt', 3: '7pt',     4: '6pt'  };
    const AT = '\u0040'; // unicode for the at-sign, avoids Razor parsing

    function buildPrintCss(w, f, cols) {
        return AT + 'media print {\n'
             + '  .slip-col {\n'
             + '    width: '     + w + ' !important;\n'
             + '    max-width: ' + w + ' !important;\n'
             + '    flex: 0 0 '  + w + ' !important;\n'
             + '  }\n'
             + '  .voter-slip-card { font-size: ' + f + ' !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color: #000 !important; border-color: #000 !important; }\n'
             + '  .voter-slip-card * { color: #000 !important; }\n'
             + '  .slip-col:nth-child(' + cols + 'n) { border-right: none !important; }\n'
             + '}';
    }

    // Translation cache: English text → Hindi text
    const txCache = new Map();

    // Translate a single string via Google Translate (unofficial free endpoint)
    async function gtTranslate(text) {
        if (!text || text === '-') return text;
        if (txCache.has(text)) return txCache.get(text);
        try {
            const url = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=hi&dt=t&q='
                        + encodeURIComponent(text);
            const res  = await fetch(url);
            const json = await res.json();
            const hi   = json[0].map(x => x[0]).join('');
            txCache.set(text, hi);
            return hi;
        } catch { return text; }
    }

    // Language: 'en' or 'hi'
    let currentLang = 'en';
    let translating  = false;

    async function switchLang(lang) {
        if (translating) return;
        currentLang = lang;

        // 1. Flip all labels immediately
        document.querySelectorAll('.slip-label').forEach(el => {
            const t = el.getAttribute('data-' + lang);
            if (t) el.innerHTML = t + '\u00a0';
        });

        if (lang === 'hi') {
            // 2. Collect all slip-val elements and unique English texts
            const valEls     = [...document.querySelectorAll('.slip-val')];
            const needFetch  = [];

            valEls.forEach(el => {
                const en = el.getAttribute('data-en') || '';
                // Use preset Hindi (NameLocal) if available
                if (el.hasAttribute('data-hi-preset')) {
                    txCache.set(en, el.getAttribute('data-hi-preset'));
                } else if (!txCache.has(en) && en && en !== '-') {
                    needFetch.push(en);
                }
            });

            const uniqueTexts = [...new Set(needFetch)];

            if (uniqueTexts.length > 0) {
                // 3. Show a spinner in the toolbar while translating
                translating = true;
                const spinner = document.getElementById('langSpinner');
                if (spinner) spinner.style.display = 'inline-block';

                // 4. Batch translate (parallel, deduped)
                await Promise.all(uniqueTexts.map(t => gtTranslate(t)));

                if (spinner) spinner.style.display = 'none';
                translating = false;
            }

            // 5. Apply Hindi text to every value span
            valEls.forEach(el => {
                const en = el.getAttribute('data-en') || '';
                el.textContent = txCache.has(en) ? txCache.get(en) : en;
            });

        } else {
            // Revert all values to English
            document.querySelectorAll('.slip-val').forEach(el => {
                el.textContent = el.getAttribute('data-en') || '';
            });
        }
    }

    function setColumns(n) {
        // 1. Update screen layout classes
        document.querySelectorAll('#slipContainer .slip-col').forEach(el => {
            el.className = el.className.replace(/\bcol-\d+\b/, colClasses[n]);
        });

        // 2. Rewrite the dynamic print style
        document.getElementById('printColStyle').textContent =
            buildPrintCss(colWidths[n], colFontPt[n], n);

        // 3. Update screen nth-child cut-line rule to match new column count
        document.querySelectorAll('#slipContainer .slip-col').forEach((el, idx) => {
            el.style.borderRight = ((idx + 1) % n === 0) ? 'none' : '1.5px dashed #aaa';
        });

        // 3. Toggle button active states
        [2, 3, 4].forEach(i => {
            const btn = document.getElementById('col' + i + 'Btn');
            btn.classList.toggle('btn-primary',           i === n);
            btn.classList.toggle('active',                i === n);
            btn.classList.toggle('btn-outline-secondary', i !== n);
        });

        // 4. Reflect new column count in the info banner
        const lbl = document.getElementById('colCountLabel');
        if (lbl) lbl.textContent = n;
    }
</script>
}
