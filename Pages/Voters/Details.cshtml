@page "{id:int}"
@model Nirvachak_AI.Pages.Voters.DetailsModel
@{
    ViewData["Title"] = "Voter Details";
}

@if (Model.Voter == null)
{
    <div class="alert alert-warning">Voter not found.</div>
    return;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-auto-dismiss">@TempData["Message"]</div>
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:80px;height:80px;">
                    <i class="bi bi-person-fill fs-1 text-secondary"></i>
                </div>
                <h5 class="mb-0">@Model.Voter.Name</h5>
                @if (!string.IsNullOrEmpty(Model.Voter.NameLocal))
                {
                    <div class="text-muted small">@Model.Voter.NameLocal</div>
                }
                <div class="mt-2">
                    <span class="badge badge-@Model.Voter.Sentiment.ToString().ToLower() fs-6">@Model.Voter.Sentiment</span>
                </div>
                <div class="mt-3">
                    <span class="badge bg-secondary font-monospace fs-6">@Model.Voter.VoterId</span>
                </div>
            </div>
            <div class="card-footer">
                <!-- Update Sentiment -->
                <form method="post" asp-page-handler="UpdateSentiment" class="mb-2">
                    <input type="hidden" name="id" value="@Model.Voter.Id" />
                    <div class="input-group input-group-sm">
                        <select name="sentiment" class="form-select form-select-sm">
                            @foreach (var s in Enum.GetValues<VoterSentiment>())
                            {
                                if (Model.Voter.Sentiment == s)
                                {
                                    <option value="@s" selected>@s</option>
                                }
                                else
                                {
                                    <option value="@s">@s</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                    </div>
                </form>
                <div class="d-flex gap-2">
                    <a asp-page="/Voters/Edit" asp-route-id="@Model.Voter.Id" class="btn btn-sm btn-outline-secondary flex-fill">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-page="/Voters/Index" class="btn btn-sm btn-outline-secondary flex-fill">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-clipboard2-data-fill me-2 text-secondary"></i>Self-Survey Profile</span>
                @if (Model.SurveyCompleted)
                {
                    <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Survey Completed</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Not Yet Completed</span>
                }
            </div>
            @if (Model.SurveyProfile != null)
            {
                <div class="card-body">
                    <div class="row g-2 small">
                        <div class="col-6"><strong>Age Bracket:</strong> @(Model.SurveyProfile.AgeBracket ?? "—")</div>
                        <div class="col-6"><strong>Caste Category:</strong> @(Model.SurveyProfile.CasteCategory ?? "—")</div>
                        <div class="col-6"><strong>Religion:</strong> @(Model.SurveyProfile.Religion ?? "—")</div>
                        <div class="col-6"><strong>Education:</strong> @(Model.SurveyProfile.Education ?? "—")</div>
                        <div class="col-6"><strong>Occupation:</strong> @(Model.SurveyProfile.Occupation ?? "—")</div>
                        <div class="col-6"><strong>Income Bracket:</strong> @(Model.SurveyProfile.MonthlyIncomeBracket ?? "—")</div>
                        <div class="col-6"><strong>Language:</strong> @(Model.SurveyProfile.PreferredLanguage ?? "—")</div>
                        @if (!string.IsNullOrEmpty(Model.SurveyProfile.PrimaryConcerns))
                        {
                            var concerns = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.SurveyProfile.PrimaryConcerns) ?? new();
                            <div class="col-12">
                                <strong>Top Concerns:</strong>
                                @foreach (var c in concerns)
                                {
                                    <span class="badge bg-warning text-dark me-1">@c</span>
                                }
                            </div>
                        }
                    </div>
                    @if (Model.ConsentRecord != null)
                    {
                        <hr class="my-2" />
                        <div class="small fw-semibold mb-1"><i class="bi bi-shield-check me-1 text-success"></i>Consents Given</div>
                        <div class="d-flex flex-wrap gap-1">
                            @if (Model.ConsentRecord.AllowThirdPartyAdvertising)
                            { <span class="badge bg-success">3rd-Party Ads</span> }
                            @if (Model.ConsentRecord.AllowCampaignOutreach)
                            { <span class="badge bg-primary">Campaign Outreach</span> }
                            @if (Model.ConsentRecord.AllowWhatsAppMessages)
                            { <span class="badge bg-success">WhatsApp</span> }
                            @if (Model.ConsentRecord.AllowSchemeNotifications)
                            { <span class="badge bg-info text-dark">Scheme Notifications</span> }
                            @if (Model.ConsentRecord.AllowDataForAnalytics)
                            { <span class="badge bg-secondary">Analytics</span> }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card-body text-center text-muted py-3 small">
                    <i class="bi bi-inbox me-1"></i>Voter has not completed the self-survey yet.
                    @if (!string.IsNullOrEmpty(Model.Voter?.MobileNumber))
                    {
                        var surveyUrl = $"{Request.Scheme}://{Request.Host}/Survey";
                        var msg = Uri.EscapeDataString($"Dear {Model.Voter.Name}, please fill in this quick voter survey and claim your reward: {surveyUrl}");
                        <a href="https://wa.me/91@(Model.Voter.MobileNumber)?text=@msg" target="_blank"
                           class="btn btn-sm btn-success ms-2 py-0">
                            <i class="bi bi-whatsapp me-1"></i>Send Survey Link
                        </a>
                    }
                </div>
            }
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-person-lines-fill me-2"></i>Voter Information</div>
            <div class="card-body">
                    <div class="col-6"><strong>EPIC No.:</strong> <span class="font-monospace">@Model.Voter.VoterId</span></div>
                    <div class="col-6"><strong>Age:</strong> @Model.Voter.Age</div>
                    <div class="col-6"><strong>Gender:</strong> @(Model.Voter.Gender == "M" ? "Male" : Model.Voter.Gender == "F" ? "Female" : "Other")</div>
                    <div class="col-6"><strong>Father/Husband:</strong> @(Model.Voter.FatherHusbandName ?? "�")</div>
                    <div class="col-6"><strong>Mobile:</strong> @(Model.Voter.MobileNumber ?? "�")</div>
                    <div class="col-12"><strong>Address:</strong> @Model.Voter.Address</div>
                    <div class="col-6"><strong>Booth No.:</strong> @Model.Voter.BoothNumber</div>
                    <div class="col-6"><strong>Ward No.:</strong> @(Model.Voter.WardNumber ?? "�")</div>
                    <div class="col-6"><strong>Panna No.:</strong> @(Model.Voter.PannaNumber ?? "�")</div>
                    <div class="col-6"><strong>Election Day:</strong>
                        <span class="badge @(Model.Voter.ElectionDayStatus == ElectionDayStatus.Voted ? "bg-success" : "bg-light text-dark")">
                            @Model.Voter.ElectionDayStatus
                        </span>
                    </div>
                    @if (Model.Voter.Notes != null)
                    {
                        <div class="col-12"><strong>Notes:</strong> @Model.Voter.Notes</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Voter.HouseholdId))
                    {
                        <div class="col-12">
                            <strong>Household ID:</strong>
                            <span class="font-monospace badge bg-light text-dark border">@Model.Voter.HouseholdId</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Household members *@
        @if (Model.HouseholdMembers.Any())
        {
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-people-fill me-2 text-info"></i>
                Household Members <span class="badge bg-info ms-1">@Model.HouseholdMembers.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Name</th><th>EPIC</th><th>Age/Gender</th><th>Sentiment</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var m in Model.HouseholdMembers)
                        {
                            <tr>
                                <td class="fw-semibold small">@m.Name</td>
                                <td class="font-monospace small">@m.VoterId</td>
                                <td class="small">@m.Age / @m.Gender</td>
                                <td><span class="badge badge-@m.Sentiment.ToString().ToLower()">@m.Sentiment</span></td>
                                <td><a asp-page="/Voters/Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-eye"></i></a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        }

        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-door-open me-2"></i>Door-to-Door Visit History</span>
                @if (Model.Visits.Any())
                {
                    <span class="badge bg-secondary">@Model.Visits.Count visit(s)</span>
                }
            </div>
            @if (Model.Visits.Any())
            {
                var latest = Model.Visits.First();
                <div class="card-body py-2 border-bottom bg-light">
                    <div class="small fw-semibold text-muted mb-1"><i class="bi bi-clock me-1"></i>Latest visit — @latest.VisitedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") by @latest.WorkerName</div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="badge bg-info text-dark">@latest.Status</span>
                        <span class="badge badge-@latest.SentimentAfterVisit.ToString().ToLower()">@latest.SentimentAfterVisit</span>
                        @if (!string.IsNullOrEmpty(latest.Notes))
                        {
                            <span class="small text-dark fst-italic">&ldquo;@latest.Notes&rdquo;</span>
                        }
                    </div>
                </div>
            }
            <div class="card-body p-0">
                @if (!Model.Visits.Any())
                {
                    <div class="text-center text-muted py-3 small">No visits recorded yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Date</th><th>Worker</th><th>Status</th><th>Sentiment</th><th>Notes</th></tr></thead>
                            <tbody>
                            @foreach (var v in Model.Visits)
                            {
                                <tr>
                                    <td class="small">@v.VisitedAt.ToString("dd MMM yy")</td>
                                    <td class="small">@v.WorkerName</td>
                                    <td><span class="badge bg-info">@v.Status</span></td>
                                    <td><span class="badge badge-@v.SentimentAfterVisit.ToString().ToLower()">@v.SentimentAfterVisit</span></td>
                                    <td class="small">@v.Notes</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="card-footer">
                <!-- Log a visit -->
                <form method="post" asp-page-handler="LogVisit" class="row g-2">
                    <input type="hidden" name="id" value="@Model.Voter.Id" />
                    <div class="col-md-4">
                        <select name="visitStatus" class="form-select form-select-sm">
                            @foreach (var vs in Enum.GetValues<VisitStatus>())
                            {
                                <option value="@vs">@vs</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select name="sentiment" class="form-select form-select-sm">
                            @foreach (var s in Enum.GetValues<VoterSentiment>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes..." />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-sm btn-success">
                            <i class="bi bi-plus-circle me-1"></i>Log Visit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
