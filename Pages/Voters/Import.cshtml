@page
@model Nirvachak_AI.Pages.Voters.ImportModel
@{
    ViewData["Title"] = "Import Voters";
}

<div class="row justify-content-center">
    <div class="col-md-10">

        @* ?? Result summary banner ??????????????????????????????????????? *@
        @if (Model.Result != null)
        {
            if (Model.Result.Success && Model.Result.Skipped == 0)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>Import Complete — all rows loaded successfully!</strong>
                    &nbsp;<span class="badge bg-success">@Model.Result.Imported Imported</span>
                    &nbsp;<span class="badge bg-secondary">@Model.Result.Total Total Rows</span>
                </div>
            }
            else if (Model.Result.Success && Model.Result.Skipped > 0)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    <strong>Import Complete with issues.</strong>
                    &nbsp;<span class="badge bg-success">@Model.Result.Imported Imported</span>
                    &nbsp;<span class="badge bg-warning text-dark">@Model.Result.Skipped Skipped</span>
                    &nbsp;<span class="badge bg-secondary">@Model.Result.Total Total Rows</span>
                    <div class="small mt-1 text-dark">See the failed rows table below — download, fix and re-upload.</div>
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    <strong>Import Failed:</strong> @string.Join(" | ", Model.Result.Errors)
                </div>
            }
        }

        @* ?? Failed Rows Panel (only when skipped rows exist) ??????????? *@
        @if (Model.FailedRows.Any())
        {
            <div class="card border-warning mb-4">
                <div class="card-header bg-warning bg-opacity-10 border-warning d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                        <strong>@Model.FailedRows.Count row(s) could not be imported</strong>
                        <span class="text-muted small ms-2">— correct the issues and re-upload</span>
                    </div>
                    <a asp-page-handler="DownloadFailed" class="btn btn-sm btn-warning">
                        <i class="bi bi-download me-1"></i>Download Failed Rows as CSV
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:380px; overflow-y:auto;">
                        <table class="table table-sm table-hover mb-0 small">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>#</th>
                                    <th>Voter ID</th>
                                    <th>Name</th>
                                    <th>Booth</th>
                                    <th>Serial</th>
                                    <th>Age</th>
                                    <th>Gender</th>
                                    <th class="text-danger">Reason for Failure</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNum = 1; }
                                @foreach (var row in Model.FailedRows)
                                {
                                    <tr>
                                        <td class="text-muted">@rowNum++</td>
                                        <td class="font-monospace">@row.VoterId</td>
                                        <td>@row.Name</td>
                                        <td>@row.BoothNumber</td>
                                        <td>@row.SerialNumber</td>
                                        <td>@row.Age</td>
                                        <td>@row.Gender</td>
                                        <td><span class="badge bg-danger bg-opacity-75">@row.FailReason</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @* ?? Upload form ????????????????????????????????????????????????? *@
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-upload me-2"></i>Upload Voter CSV File</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    @if (Model.IsSuperAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Constituency</label>
                            <select asp-for="SelectedConstituencyId" asp-items="Model.ConstituencyItems" class="form-select">
                                <option value="">-- Select Constituency --</option>
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="SelectedConstituencyId" />
                    }
                    <div class="mb-3">
                        <label class="form-label fw-semibold">CSV File</label>
                        <input type="file" name="csvFile" accept=".csv" class="form-control" required />
                        <div class="form-text">Upload voter roll in CSV format. Max 50,000 rows per upload.</div>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-cloud-upload me-1"></i>Import Voters
                    </button>
                </form>
            </div>
        </div>

        @* ?? CSV Format Guide ???????????????????????????????????????????? *@
        <div class="card">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>CSV Format Guide</div>
            <div class="card-body">
                <p class="small text-muted mb-2">Your CSV file must have these column headers (first row):</p>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered small">
                        <thead class="table-light">
                            <tr><th>Column</th><th>Required</th><th>Example</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><code>VoterId</code></td><td><span class="badge bg-danger">Required</span></td><td>MH01234567</td><td>EPIC number</td></tr>
                            <tr><td><code>Name</code></td><td><span class="badge bg-danger">Required</span></td><td>Rajesh Kumar</td><td>Full name</td></tr>
                            <tr><td><code>Age</code></td><td><span class="badge bg-danger">Required</span></td><td>45</td><td>Age in years</td></tr>
                            <tr><td><code>Gender</code></td><td><span class="badge bg-danger">Required</span></td><td>M</td><td>M / F / O</td></tr>
                            <tr><td><code>Address</code></td><td><span class="badge bg-danger">Required</span></td><td>House 5, Ward 2</td><td>Full address</td></tr>
                            <tr><td><code>BoothNumber</code></td><td><span class="badge bg-danger">Required</span></td><td>3</td><td>Polling booth number</td></tr>
                            <tr><td><code>SerialNumber</code></td><td><span class="badge bg-danger">Required</span></td><td>127</td><td>Serial in voter list</td></tr>
                            <tr><td><code>NameLocal</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Local Name</td><td>Regional language name</td></tr>
                            <tr><td><code>FatherHusbandName</code></td><td><span class="badge bg-secondary">Optional</span></td><td>Ram Kumar</td><td>Father/Husband name</td></tr>
                            <tr><td><code>MobileNumber</code></td><td><span class="badge bg-secondary">Optional</span></td><td>9876543210</td><td>10-digit mobile</td></tr>
                            <tr><td><code>WardNumber</code></td><td><span class="badge bg-secondary">Optional</span></td><td>5</td><td>Ward number</td></tr>
                            <tr><td><code>PannaNumber</code></td><td><span class="badge bg-secondary">Optional</span></td><td>13</td><td>Panna/Page number</td></tr>
                        </tbody>
                    </table>
                </div>
                <a href="/SampleData/sample_voters.csv" download class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-download me-1"></i>Download Sample CSV
                </a>
            </div>
        </div>

    </div>
</div>
