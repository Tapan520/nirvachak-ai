@page
@model Nirvachak_AI.Pages.Voters.IndexModel
@{
    ViewData["Title"] = "Voter List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="text-muted small">@Model.TotalCount voters found</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanImportCsv)
        {
            <a asp-page="/Voters/Import" class="btn btn-success btn-sm">
                <i class="bi bi-upload me-1"></i>Import CSV
            </a>
        }
        @if (Model.CanAddVoter)
        {
            <a asp-page="/Voters/Create" class="btn btn-primary btn-sm">
                <i class="bi bi-person-plus-fill me-1"></i>Add Voter
            </a>
        }
        <a asp-page="/VoterSlips/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i>Print Slips
        </a>
        @if (Model.CanBulkDelete)
        {
            <button class="btn btn-outline-danger btn-sm" type="button"
                    data-bs-toggle="collapse" data-bs-target="#deleteBoothPanel">
                <i class="bi bi-trash-fill me-1"></i>Delete by Booth
            </button>
        }
    </div>
</div>

@* ── Delete by Booth Panel (Admin / SuperAdmin only) ─────────────────── *@
@if (Model.CanBulkDelete)
{
<div class="collapse mb-3" id="deleteBoothPanel">
    <div class="card border-danger">
        <div class="card-header bg-danger bg-opacity-10 border-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
            <strong class="text-danger">Bulk Delete Voters</strong>
            <span class="text-muted small ms-1">— this action soft-deletes records and cannot be undone easily</span>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="DeleteBooth"
                  onsubmit="return confirmBoothDelete(this)">
                <div class="row g-2 align-items-end">
                    @if (Model.IsAdmin)
                    {
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Constituency</label>
                            <select name="deleteConstituencyId" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                @foreach (var c in Model.Constituencies)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="deleteConstituencyId" value="@Model.ConstituencyFilter" />
                    }
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Booth</label>
                        <select name="deleteBoothNumber" id="deleteBoothNumber" class="form-select form-select-sm">
                            <option value="">-- Select Booth --</option>
                            @foreach (var b in Model.BoothNumbers)
                            {
                                <option value="@b">Booth @b</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small d-block">Scope</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="deleteAll" id="delBooth"
                                   value="false" checked onchange="toggleBoothSelect(false)" />
                            <label class="form-check-label small" for="delBooth">Selected Booth only</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="deleteAll" id="delAll"
                                   value="true" onchange="toggleBoothSelect(true)" />
                            <label class="form-check-label small text-danger fw-semibold" for="delAll">All Booths (entire constituency)</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            <i class="bi bi-trash-fill me-1"></i>Delete Voters
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
        <i class="bi bi-check2-circle me-1"></i>@TempData["Message"]
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            @if (Model.IsAdmin)
            {
                <div class="col-md-3">
                    <select asp-for="ConstituencyFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All Constituencies</option>
                        @foreach (var c in Model.Constituencies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-3">
                <input asp-for="Search" class="form-control form-control-sm" placeholder="Search name / EPIC / mobile..." />
            </div>
            <div class="col-md-2">
                <select asp-for="WardFilter" class="form-select form-select-sm">
                    <option value="">All Wards</option>
                    @foreach (var w in Model.Wards)
                    {
                        <option value="@w.WardNumber">Ward @w.WardNumber – @w.WardName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select asp-for="BoothFilter" class="form-select form-select-sm">
                    <option value="">All Booths</option>
                    @foreach (var b in Model.BoothNumbers)
                    {
                        <option value="@b">Booth @b</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select asp-for="SentimentFilter" class="form-select form-select-sm">
                    <option value="">All Sentiments</option>
                    @foreach (var s in Enum.GetValues<VoterSentiment>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select asp-for="GenderFilter" class="form-select form-select-sm">
                    <option value="">All Genders</option>
                    <option value="M">Male</option>
                    <option value="F">Female</option>
                    <option value="O">Other</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i></button>
            </div>
            <div class="col-md-1">
                <a asp-page="/Voters/Index" class="btn btn-outline-secondary btn-sm w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-page-handler="BulkSentiment" id="bulkForm">
<div class="card mb-2" id="bulkActionBar" style="display:none">
    <div class="card-body py-2 d-flex align-items-center gap-3 bg-primary-subtle">
        <span class="small fw-semibold text-primary"><span id="selectedCount">0</span> voter(s) selected</span>
        <select name="bulkSentiment" class="form-select form-select-sm" style="max-width:160px">
            @foreach (var s in Enum.GetValues<VoterSentiment>())
            {
                <option value="@s">@s</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-pencil-square me-1"></i>Update Sentiment
        </button>
        @if (Model.CanBulkDelete)
        {
            <button type="submit" formaction="/Voters/Index?handler=BulkDelete"
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('Delete the selected voter(s)? This cannot be easily undone.');">
                <i class="bi bi-trash-fill me-1"></i>Delete Selected
            </button>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" onclick="clearSelection()">
            <i class="bi bi-x-lg me-1"></i>Clear
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:36px"><input type="checkbox" id="selectAll" class="form-check-input" title="Select all"></th>
                        <th>#</th>
                        <th>EPIC</th>
                        <th>Name</th>
                        <th>Age/Gender</th>
                        <th>Booth</th>
                        <th>Mobile</th>
                        <th>Sentiment</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var v in Model.Voters)
                {
                    <tr class="voter-@v.Sentiment.ToString().ToLower()">
                        <td><input type="checkbox" name="selectedIds" value="@v.Id" class="form-check-input voter-checkbox"></td>
                        <td class="text-muted small">@v.SerialNumber</td>
                        <td><span class="badge bg-light text-dark font-monospace">@v.VoterId</span></td>
                        <td>
                            <div class="fw-semibold">@v.Name</div>
                            @if (!string.IsNullOrEmpty(v.FatherHusbandName))
                            {
                                <div class="text-muted" style="font-size:0.75rem">S/O @v.FatherHusbandName</div>
                            }
                            @if (v.IsSelfRegistered)
                            {
                                <span class="badge bg-warning text-dark" style="font-size:0.65rem">Self-Reg</span>
                            }
                        </td>
                        <td>@v.Age / @v.Gender</td>
                        <td><span class="badge bg-secondary">@v.BoothNumber</span></td>
                        <td>@(v.MobileNumber ?? "-")</td>
                        <td>
                            <span class="badge badge-@v.Sentiment.ToString().ToLower()">@v.Sentiment</span>
                        </td>
                        <td>
                            @if (v.ElectionDayStatus == ElectionDayStatus.Voted)
                            {
                                <span class="badge bg-success">Voted</span>
                            }
                            else if (v.ElectionDayStatus == ElectionDayStatus.Absent)
                            {
                                <span class="badge bg-secondary">Absent</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted">Not Voted</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Voters/Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Voters.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            No voters found.
                            <a asp-page="/Voters/Create">Add a voter</a>
                            @if (Model.CanImportCsv)
                            {
                                <span>or <a asp-page="/Voters/Import">import from CSV</a>.</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        int cur   = Model.CurrentPage;
        int total = Model.TotalPages;
        int from  = Math.Max(1, cur - 3);
        int to    = Math.Min(total, cur + 3);
        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">Page @cur of @total</small>
            <nav aria-label="Voter list pagination">
                <ul class="pagination pagination-sm mb-0 flex-wrap">
                    @* First + Prev *@
                    <li class="page-item @(cur == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Voters/Index" asp-route-currentPage="1"
                           asp-route-search="@Model.Search" asp-route-constituencyFilter="@Model.ConstituencyFilter"
                           asp-route-wardFilter="@Model.WardFilter" asp-route-boothFilter="@Model.BoothFilter"
                           asp-route-sentimentFilter="@Model.SentimentFilter" asp-route-genderFilter="@Model.GenderFilter"
                           title="First">&laquo;</a>
                    </li>
                    <li class="page-item @(cur == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Voters/Index" asp-route-currentPage="@(cur - 1)"
                           asp-route-search="@Model.Search" asp-route-constituencyFilter="@Model.ConstituencyFilter"
                           asp-route-wardFilter="@Model.WardFilter" asp-route-boothFilter="@Model.BoothFilter"
                           asp-route-sentimentFilter="@Model.SentimentFilter" asp-route-genderFilter="@Model.GenderFilter"
                           title="Previous">&lsaquo;</a>
                    </li>

                    @* Leading ellipsis *@
                    @if (from > 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }

                    @* Page window *@
                    @for (int p = from; p <= to; p++)
                    {
                        <li class="page-item @(p == cur ? "active" : "")">
                            <a class="page-link" asp-page="/Voters/Index" asp-route-currentPage="@p"
                               asp-route-search="@Model.Search" asp-route-constituencyFilter="@Model.ConstituencyFilter"
                               asp-route-wardFilter="@Model.WardFilter" asp-route-boothFilter="@Model.BoothFilter"
                               asp-route-sentimentFilter="@Model.SentimentFilter" asp-route-genderFilter="@Model.GenderFilter">@p</a>
                        </li>
                    }

                    @* Trailing ellipsis *@
                    @if (to < total)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }

                    @* Next + Last *@
                    <li class="page-item @(cur == total ? "disabled" : "")">
                        <a class="page-link" asp-page="/Voters/Index" asp-route-currentPage="@(cur + 1)"
                           asp-route-search="@Model.Search" asp-route-constituencyFilter="@Model.ConstituencyFilter"
                           asp-route-wardFilter="@Model.WardFilter" asp-route-boothFilter="@Model.BoothFilter"
                           asp-route-sentimentFilter="@Model.SentimentFilter" asp-route-genderFilter="@Model.GenderFilter"
                           title="Next">&rsaquo;</a>
                    </li>
                    <li class="page-item @(cur == total ? "disabled" : "")">
                        <a class="page-link" asp-page="/Voters/Index" asp-route-currentPage="@total"
                           asp-route-search="@Model.Search" asp-route-constituencyFilter="@Model.ConstituencyFilter"
                           asp-route-wardFilter="@Model.WardFilter" asp-route-boothFilter="@Model.BoothFilter"
                           asp-route-sentimentFilter="@Model.SentimentFilter" asp-route-genderFilter="@Model.GenderFilter"
                           title="Last">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
</form>

@section Scripts {
<script>
    const selectAll = document.getElementById('selectAll');
    const bar       = document.getElementById('bulkActionBar');
    const countEl   = document.getElementById('selectedCount');

    function updateBar() {
        const n = document.querySelectorAll('.voter-checkbox:checked').length;
        countEl.textContent = n;
        bar.style.display = n > 0 ? 'block' : 'none';
    }

    selectAll.addEventListener('change', function () {
        document.querySelectorAll('.voter-checkbox').forEach(cb => cb.checked = this.checked);
        updateBar();
    });

    document.querySelectorAll('.voter-checkbox').forEach(cb =>
        cb.addEventListener('change', updateBar));

    function clearSelection() {
        document.querySelectorAll('.voter-checkbox, #selectAll').forEach(cb => cb.checked = false);
        updateBar();
    }

    function toggleBoothSelect(deleteAll) {
        const sel = document.getElementById('deleteBoothNumber');
        if (sel) sel.disabled = deleteAll;
    }

    function confirmBoothDelete(form) {
        const deleteAll = form.querySelector('input[name="deleteAll"]:checked')?.value === 'true';
        const booth = form.querySelector('#deleteBoothNumber')?.value;
        if (deleteAll) {
            return confirm('⚠️ You are about to DELETE ALL voters in the entire constituency. This cannot be easily undone. Are you sure?');
        }
        if (!booth) {
            alert('Please select a booth to delete.');
            return false;
        }
        return confirm(`Delete ALL voters in Booth ${booth}? This cannot be easily undone.`);
    }
</script>
}
