@page
@model Nirvachak_AI.Pages.WinProbability.IndexModel
@{
    ViewData["Title"] = "Win Probability";
    var r = Model.Result;
}

@* ?? Header ??????????????????????????????????????????????????? *@
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-0"><i class="bi bi-trophy-fill me-2 text-warning"></i>Win Probability Dashboard</h4>
        @if (Model.ActiveConstituency != null)
        {
            <p class="text-muted small mb-0">
                <i class="bi bi-geo-alt-fill me-1 text-primary"></i>@Model.ActiveConstituency.Name
                &nbsp;&middot;&nbsp;Generated: @Model.GeneratedAt
            </p>
        }
    </div>
    @if (Model.IsAdmin && Model.Constituencies.Any())
    {
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="fw-semibold mb-0 text-nowrap small">Constituency:</label>
            <select name="SelectedConstituencyId" class="form-select form-select-sm"
                    style="max-width:240px" onchange="this.form.submit()">
                @foreach (var c in Model.Constituencies)
                {
                    <option value="@c.Id" selected="@(Model.SelectedConstituencyId == c.Id)">@c.Name</option>
                }
            </select>
        </form>
    }
</div>

@if (r == null)
{
    <div class="alert alert-info">No constituency data available. Please select a constituency.</div>
}
else
{
@* ?? Score Gauge + Tier ???????????????????????????????????????? *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-@r.TierColor border-2">
            <div class="card-body d-flex flex-column align-items-center justify-content-center py-4">
                <div class="position-relative mb-2" style="width:180px;height:180px;">
                    <canvas id="gaugeChart" width="180" height="180"></canvas>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <div class="display-5 fw-bold text-@r.TierColor">@r.Score<span class="fs-4">%</span></div>
                        <div class="small text-muted">Win Probability</div>
                    </div>
                </div>
                <span class="badge bg-@r.TierColor fs-6 px-4 py-2 mt-1">@r.Tier</span>
                <p class="text-muted small text-center mt-2 mb-0">
                    @(r.Tier switch {
                        "Strong"   => "Campaign is well-positioned. Maintain momentum.",
                        "Moderate" => "Competitive position. Focus on floating voters and at-risk booths.",
                        "Weak"     => "Significant effort needed. Urgently increase outreach.",
                        _          => "Critical situation. Immediate campaign restructuring required."
                    })
                </p>
            </div>
        </div>
    </div>

    @* ?? Key Metrics ??????????????????????????????????????????? *@
    <div class="col-md-8">
        <div class="row g-3">
            <div class="col-6 col-md-4">
                <div class="card h-100 stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="stat-icon bg-success bg-opacity-10"><i class="bi bi-hand-thumbs-up-fill text-success"></i></div>
                        <div>
                            <div class="fs-5 fw-bold">@r.FavourVoters.ToString("N0")</div>
                            <div class="small text-muted">In Favour</div>
                            <div class="text-muted" style="font-size:0.68rem">@r.FavourRate% of total</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card h-100 stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="stat-icon bg-warning bg-opacity-10"><i class="bi bi-arrow-left-right text-warning"></i></div>
                        <div>
                            <div class="fs-5 fw-bold">@r.FloatingVoters.ToString("N0")</div>
                            <div class="small text-muted">Floating Voters</div>
                            <div class="text-muted" style="font-size:0.68rem">+@((int)r.FloatingConversionPotential) potential</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card h-100 stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="stat-icon bg-danger bg-opacity-10"><i class="bi bi-hand-thumbs-down-fill text-danger"></i></div>
                        <div>
                            <div class="fs-5 fw-bold">@r.AgainstVoters.ToString("N0")</div>
                            <div class="small text-muted">Against</div>
                            <div class="text-muted" style="font-size:0.68rem">to be countered</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card h-100 stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="stat-icon bg-info bg-opacity-10"><i class="bi bi-person-check-fill text-info"></i></div>
                        <div>
                            <div class="fs-5 fw-bold">@r.ContactedVoters.ToString("N0")</div>
                            <div class="small text-muted">Contacted</div>
                            <div class="text-muted" style="font-size:0.68rem">@r.ContactCoverage% coverage</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card h-100 stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="stat-icon bg-danger bg-opacity-10"><i class="bi bi-exclamation-triangle-fill text-danger"></i></div>
                        <div>
                            <div class="fs-5 fw-bold">@r.BoothsAtRisk</div>
                            <div class="small text-muted">Booths At Risk</div>
                            <div class="text-muted" style="font-size:0.68rem">low turnout risk</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card h-100 stat-card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="stat-icon bg-primary bg-opacity-10"><i class="bi bi-check2-circle text-primary"></i></div>
                        <div>
                            <div class="fs-5 fw-bold">@r.EstimatedWinVotes.ToString("N0")</div>
                            <div class="small text-muted">Est. Win Votes</div>
                            <div class="text-muted" style="font-size:0.68rem">if turnout holds</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ?? Progress Bars + Analysis ?????????????????????????????????? *@
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold small">
                <i class="bi bi-bar-chart-fill me-2 text-success"></i>Campaign Progress
            </div>
            <div class="card-body">
                @{
                    var floatPct   = r.TotalVoters > 0 ? Math.Round((double)r.FloatingVoters / r.TotalVoters * 100, 1) : 0;
                    var againstPct = r.TotalVoters > 0 ? Math.Round((double)r.AgainstVoters  / r.TotalVoters * 100, 1) : 0;
                }

                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Favour Rate (of all voters)</span>
                        <span class="fw-bold">@r.FavourRate%</span>
                    </div>
                    <div class="progress" style="height:10px">
                        <div class="progress-bar bg-success" style="width:@r.FavourRate%" role="progressbar"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Voter Contact Coverage</span>
                        <span class="fw-bold">@r.ContactCoverage%</span>
                    </div>
                    <div class="progress" style="height:10px">
                        <div class="progress-bar bg-info" style="width:@r.ContactCoverage%" role="progressbar"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Floating Voters (conversion pool)</span>
                        <span class="fw-bold">@floatPct%</span>
                    </div>
                    <div class="progress" style="height:10px">
                        <div class="progress-bar bg-warning" style="width:@floatPct%" role="progressbar"></div>
                    </div>
                </div>
                <div class="mb-0">
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Against Voters (headwind)</span>
                        <span class="fw-bold">@againstPct%</span>
                    </div>
                    <div class="progress" style="height:10px">
                        <div class="progress-bar bg-danger" style="width:@againstPct%" role="progressbar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold small">
                <i class="bi bi-clipboard2-data me-2 text-primary"></i>Analysis
            </div>
            <div class="card-body">
                @if (r.StrengthPoints.Any())
                {
                    <p class="small fw-semibold text-success mb-2">
                        <i class="bi bi-check-circle-fill me-1"></i>Strengths
                    </p>
                    <ul class="list-unstyled mb-3">
                        @foreach (var s in r.StrengthPoints)
                        {
                            <li class="d-flex gap-2 align-items-start mb-2 small">
                                <i class="bi bi-check2 text-success mt-1 flex-shrink-0"></i>
                                <span>@s</span>
                            </li>
                        }
                    </ul>
                }
                @if (r.RiskPoints.Any())
                {
                    <p class="small fw-semibold text-danger mb-2">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Risks
                    </p>
                    <ul class="list-unstyled mb-0">
                        @foreach (var risk in r.RiskPoints)
                        {
                            <li class="d-flex gap-2 align-items-start mb-2 small">
                                <i class="bi bi-exclamation-circle text-danger mt-1 flex-shrink-0"></i>
                                <span>@risk</span>
                            </li>
                        }
                    </ul>
                }
                @if (!r.StrengthPoints.Any() && !r.RiskPoints.Any())
                {
                    <p class="text-muted small text-center py-3">
                        Collect more voter data to generate analysis.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@* ?? Action Shortcuts ?????????????????????????????????????????? *@
<div class="card">
    <div class="card-header fw-semibold small">
        <i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Recommended Actions
    </div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <a asp-page="/Voters/Index" asp-route-SentimentFilter="Floating"
                   class="btn btn-outline-warning w-100 text-start">
                    <i class="bi bi-arrow-left-right me-2"></i>Convert Floating Voters
                    <span class="badge bg-warning text-dark ms-1">@r.FloatingVoters</span>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-page="/Voters/Index" asp-route-SentimentFilter="Unknown"
                   class="btn btn-outline-secondary w-100 text-start">
                    <i class="bi bi-person-question-fill me-2"></i>Reach Unknown Voters
                </a>
            </div>
            <div class="col-md-3">
                <a asp-page="/Predictions/Index" class="btn btn-outline-primary w-100 text-start">
                    <i class="bi bi-graph-up-arrow me-2"></i>Booth Predictions
                    @if (r.BoothsAtRisk > 0)
                    {
                        <span class="badge bg-danger ms-1">@r.BoothsAtRisk at risk</span>
                    }
                </a>
            </div>
            <div class="col-md-3">
                <a asp-page="/Campaign/Index" class="btn btn-outline-success w-100 text-start">
                    <i class="bi bi-calendar-plus me-2"></i>Schedule Events
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const tierColors = { Strong: '#2f9e44', Moderate: '#f59f00', Weak: '#e03131', Critical: '#e03131' };
    const gaugeColor = tierColors['@r.Tier'] ?? '#868e96';
    const score = @r.Score;

    new Chart(document.getElementById('gaugeChart'), {
        type: 'doughnut',
        data: {
            datasets: [{
                data: [score, 100 - score],
                backgroundColor: [gaugeColor, '#e9ecef'],
                borderWidth: 0,
                circumference: 270,
                rotation: 225
            }]
        },
        options: {
            responsive: false,
            cutout: '75%',
            plugins: { legend: { display: false }, tooltip: { enabled: false } }
        }
    });
</script>
}
}
